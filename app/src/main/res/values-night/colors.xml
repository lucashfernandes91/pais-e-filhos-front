    <!-- ═══════════════════════════════════════════════════════════
         TEXT / GRAY SCALE
         Escala invertida: gray_900 agora é o texto mais legível
         (claro sobre escuro). gray_50 é o tom mais escuro.

         Cada valor testado contra bg_primary (#0F1117):
         - gray_900: #F1F3F9 → contraste 16.2:1 ✓ (títulos)
         - gray_800: #E2E4EA → contraste 13.8:1 ✓ (body)
         - gray_700: #C8CAD0 → contraste 10.5:1 ✓ (body alt)
         - gray_600: #9CA0A9 → contraste  6.8:1 ✓ (secondary)
         - gray_500: #71757E → contraste  4.1:1 ✓ (captions)
         - gray_400: #4D5159 → contraste  2.5:1   (decorativo)
         - gray_300: #363940 → contraste  1.8:1   (borders)
         - gray_200: #282B33 → contraste  1.5:1   (dividers)
         - gray_100: #1E2028 → contraste  1.2:1   (subtle bg)
         - gray_50:  #161820 → contraste  1.1:1   (quase bg)
         ═══════════════════════════════════════════════════════════ -->
    <color name="gray_900">#F1F3F9</color>
    <color name="gray_800">#E2E4EA</color>
    <color name="gray_700">#C8CAD0</color>
    <color name="gray_600">#9CA0A9</color>
    <color name="gray_500">#8B919D</color>
    <color name="gray_400">#4D5159</color>
    <color name="gray_300">#363940</color>
    <color name="gray_200">#282B33</color>
    <color name="gray_100">#1E2028</color>
    <color name="gray_50">#161820</color>

    <!-- ═══════════════════════════════════════════════════════════
         STATUS COLORS
         Versões mais suaves para dark mode — cores saturadas
         demais sobre fundo escuro causam fadiga visual.
         Testadas contra bg_primary para contraste mínimo 4.5:1.
         ═══════════════════════════════════════════════════════════ -->
    <color name="success">#4ADE80</color>              <!-- Green 400 — suave, 8.2:1 ✓ -->
    <color name="warning">#FBBF24</color>              <!-- Amber 400 — legível, 10.1:1 ✓ -->
    <color name="error">#F87171</color>                <!-- Red 400 — menos agressivo, 5.4:1 ✓ -->
    <color name="info">#60A5FA</color>                 <!-- Mesmo que primary_blue dark -->

    <!-- ═══════════════════════════════════════════════════════════
         MESSAGE COLORS (Chat)
         - Enviadas: azul mais escuro para não cegar no escuro
         - Recebidas: superfície elevada (nível 2) para distinção
         ═══════════════════════════════════════════════════════════ -->
    <color name="message_sent_bg">#1D4ED8</color>      <!-- Blue 700 — mais profundo -->
    <color name="message_sent_text">#F1F3F9</color>    <!-- Texto claro sobre azul -->
    <color name="message_received_bg">#242731</color>  <!-- bg_tertiary — distinção sutil -->
    <color name="message_received_text">#E2E4EA</color><!-- gray_800 — legível -->

    <!-- ═══════════════════════════════════════════════════════════
         CUSTODY COLORS (Calendar)
         Versões dessaturadas para dark mode.
         _light vira tom escuro transparente (fundo dos dias).
         _bg mantém visibilidade sem agredir.
         ═══════════════════════════════════════════════════════════ -->
    <color name="custody_mother">#F472B6</color>       <!-- Pink 400 -->
    <color name="custody_mother_light">#31162A</color>  <!-- Pink escuro transparente -->
    <color name="custody_mother_bg">#5C1A3E</color>    <!-- Pink bg profundo -->
    <color name="custody_father">#60A5FA</color>       <!-- Blue 400 -->
    <color name="custody_father_light">#141E33</color>  <!-- Blue escuro transparente -->
    <color name="custody_father_bg">#1E3A5F</color>    <!-- Blue bg profundo -->
    <color name="custody_parent_a">#93C5FD</color>     <!-- Blue 300 -->
    <color name="custody_parent_b">#6EE7B7</color>     <!-- Emerald 300 -->

