<?xml version="1.0" encoding="utf-8"?>
<!--
    Material Icons: chat_bubble_outline — versão outline real com dois paths (fill-rule evenodd)
    Fonte: https://fonts.google.com/icons — chat_bubble_outline
    Efeito: apenas o contorno visível, interior transparente
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        Path composto: desenha o balão externo e "fura" o interior
        usando dois sub-paths no mesmo pathData com fill-rule evenodd.

        Sub-path 1 (exterior): balão completo preenchido
        Sub-path 2 (interior): área interna — subtrai pelo evenodd
    -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="
            M20,2 L4,2 C2.9,2 2,2.9 2,4 L2,22 L6,18 L20,18 C21.1,18 22,17.1 22,16 L22,4 C22,2.9 21.1,2 20,2 Z
            M20,16 L5.17,16 L4,17.17 L4,4 L20,4 Z
        "/>
</vector>
