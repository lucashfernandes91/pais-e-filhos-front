<?xml version="1.0" encoding="utf-8"?>
<!--
    Config para release: somente HTTPS, sem cleartext.
    Para builds de debug, src/debug/res/xml/network_security_config.xml
    sobrescreve este arquivo e permite cleartext nos hosts de dev
    (10.0.2.2, localhost, 127.0.0.1).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
