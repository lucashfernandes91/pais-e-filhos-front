<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CoParent.List.Card.Outlined"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    >

    <LinearLayout
        style="@style/Widget.CoParent.List.Row">

        <!-- Date badge -->
        <FrameLayout
            android:id="@+id/iconFrame"
            style="@style/Widget.CoParent.List.IconFrame"
            android:importantForAccessibility="yes">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvEventDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_s_plus"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvEventMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:textSize="@dimen/text_size_micro"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue"
                    android:letterSpacing="0.04"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>

        <!-- Event Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.CoParent.List.Title"
                android:id="@+id/tvEventTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                style="@style/TextAppearance.CoParent.List.Meta"
                android:id="@+id/tvEventTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stroke_width_emphasis" />
        </LinearLayout>

        <!-- Add to Calendar Button -->
        <ImageView
            android:id="@+id/btnAddToCalendar"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_calendar_add"
            android:contentDescription="@string/ui_adicionar_ao_google_calendar"
            app:tint="@color/primary_blue"
            android:layout_marginStart="@dimen/spacing_s" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
