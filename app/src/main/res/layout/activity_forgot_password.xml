<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.CoParent.Auth.Content">

        <include
            layout="@layout/view_auth_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auth_header_form_gap" />

        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_usuario_ou_email"
            android:labelFor="@id/etIdentifier" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIdentifier"
            style="@style/Widget.CoParent.Form.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIdentifier"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:hint="@string/ui_ex_ana_silva"
                android:inputType="text"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvForgotError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_m"
            android:background="@drawable/bg_form_feedback_error"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_sm"
            android:textColor="@color/feedback_error_text"
            android:textSize="@dimen/text_size_s"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendCode"
            style="@style/Widget.CoParent.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_enviar_codigo" />
    </LinearLayout>
</ScrollView>
