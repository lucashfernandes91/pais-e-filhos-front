<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="@dimen/entry_content_padding_horizontal"
    android:background="@color/surface_container">

    <FrameLayout
        style="@style/Widget.CoParent.Onboarding.Hero">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/onboarding_hero_icon_size"
            android:layout_height="@dimen/onboarding_hero_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        style="@style/TextAppearance.CoParent.Onboarding.Title"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:layout_marginBottom="@dimen/onboarding_title_description_gap"
        android:lineSpacingExtra="@dimen/stroke_width_emphasis" />

    <TextView
        style="@style/TextAppearance.CoParent.Onboarding.Body"
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/onboarding_page_max_width"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/spacing_xs" />
</LinearLayout>
