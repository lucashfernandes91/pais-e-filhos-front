<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_secondary"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/screen_content_bottom_padding">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_s"
                android:gravity="center_vertical"
                android:background="@color/bg_primary">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAgendaTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_agenda"
                        android:textSize="@dimen/text_size_xl"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900" />

                    <TextView
                        android:id="@+id/tvCurrentMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_s"
                        android:textColor="@color/gray_500" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddEvent"
                    style="@style/Widget.CoParent.Button.Primary.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="@string/ui_novo"
                    android:contentDescription="@string/cd_add_event_button"
                    android:textSize="@dimen/text_size_s"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/spacing_s"
                    app:iconSize="@dimen/icon_size_sm"
                    app:iconTint="@color/on_primary"
                    android:minWidth="@dimen/button_min_width_action"
                    android:paddingStart="@dimen/spacing_m"
                    android:paddingEnd="@dimen/spacing_m" />
            </LinearLayout>

            <View
                style="@style/Widget.CoParent.Header.Divider"
                android:layout_marginBottom="@dimen/spacing_s" />

            <!-- Calendar Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CoParent.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <!-- Legend Row -->
                    <LinearLayout
                        android:id="@+id/legendRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingBottom="@dimen/spacing_s">

                        <!-- Outro responsável -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginEnd="@dimen/spacing_m">

                            <View
                                android:layout_width="@dimen/icon_dot_size_m"
                                android:layout_height="@dimen/icon_dot_size_m"
                                android:background="@drawable/bg_dot_pink"
                                android:layout_marginEnd="@dimen/spacing_xs" />

                            <TextView
                                android:id="@+id/tvLegendOtherParent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/agenda_no_other_parent"
                                android:textSize="@dimen/text_size_xs"
                                android:textColor="@color/gray_500" />
                        </LinearLayout>

                        <!-- Você -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginEnd="@dimen/spacing_m">

                            <View
                                android:layout_width="@dimen/icon_dot_size_m"
                                android:layout_height="@dimen/icon_dot_size_m"
                                android:background="@drawable/bg_dot_blue"
                                android:layout_marginEnd="@dimen/spacing_xs" />

                            <TextView
                                android:id="@+id/tvLegendSelf"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/agenda_you"
                                android:textSize="@dimen/text_size_xs"
                                android:textColor="@color/gray_500" />
                        </LinearLayout>

                        <!-- Evento -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="@dimen/icon_dot_size_m"
                                android:layout_height="@dimen/icon_dot_size_m"
                                android:layout_marginEnd="@dimen/spacing_xs"
                                android:background="@drawable/bg_event_dot" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_evento"
                                android:textSize="@dimen/text_size_xs"
                                android:textColor="@color/gray_500" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Month Navigation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/spacing_xs">

                        <ImageButton
                            android:id="@+id/btnPrevMonth"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:src="@drawable/ic_arrow_back"
                            android:background="?selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_prev_month_button"
                            android:padding="@dimen/spacing_sm" />

                        <TextView
                            android:id="@+id/tvCalendarMonth"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textSize="@dimen/text_size_m"
                            android:textStyle="bold"
                            android:textColor="@color/gray_900" />

                        <ImageButton
                            android:id="@+id/btnNextMonth"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:src="@drawable/ic_arrow_forward"
                            android:background="?selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_next_month_button"
                            android:padding="@dimen/spacing_sm" />
                    </LinearLayout>

                    <!-- Days Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/spacing_xl"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_d" android:gravity="center" android:textSize="@dimen/text_size_s" android:textColor="@color/gray_400" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_s" android:gravity="center" android:textSize="@dimen/text_size_s" android:textColor="@color/gray_400" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_t" android:gravity="center" android:textSize="@dimen/text_size_s" android:textColor="@color/gray_400" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_q" android:gravity="center" android:textSize="@dimen/text_size_s" android:textColor="@color/gray_400" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_q" android:gravity="center" android:textSize="@dimen/text_size_s" android:textColor="@color/gray_400" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_s" android:gravity="center" android:textSize="@dimen/text_size_s" android:textColor="@color/gray_400" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_s" android:gravity="center" android:textSize="@dimen/text_size_s" android:textColor="@color/gray_400" />
                    </LinearLayout>

                    <!-- Dynamic Calendar Grid -->
                    <LinearLayout
                        android:id="@+id/calendarGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upcoming Events Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_proximos_eventos"
                android:textSize="@dimen/text_size_l"
                android:textStyle="bold"
                android:textColor="@color/gray_900"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <ProgressBar
                android:id="@+id/progressLoadingAgenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/spacing_l"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite"
                android:contentDescription="@string/cd_loading_agenda" />

            <!-- Events List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/eventsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_m"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <!-- Error State -->
            <LinearLayout
                android:id="@+id/errorStateAgenda"
                style="@style/Widget.CoParent.State.Container.Content"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingTop="@dimen/spacing_l"
                android:accessibilityLiveRegion="polite"
                android:contentDescription="@string/cd_error_agenda">

                <ImageView
                    style="@style/Widget.CoParent.State.Icon.Error"
                    android:src="@drawable/ic_error_circle"
                    app:tint="@color/error"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TextAppearance.CoParent.State.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:text="@string/state_error_title" />

                <TextView
                    style="@style/TextAppearance.CoParent.State.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:gravity="center"
                    android:text="@string/agenda_error_message" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryAgenda"
                    style="@style/Widget.CoParent.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/action_try_again" />
            </LinearLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateAgenda"
                style="@style/Widget.CoParent.State.Container.Content"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingTop="@dimen/spacing_xl"
                android:accessibilityLiveRegion="polite"
                android:contentDescription="@string/cd_empty_agenda">

                <ImageView
                    style="@style/Widget.CoParent.State.Icon.Empty"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/gray_300"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TextAppearance.CoParent.State.EmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_nenhum_evento_agendado"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    style="@style/TextAppearance.CoParent.State.EmptyBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_adicione_um_evento_para_comecar_a_organizar_a"
                    android:gravity="center"
                    android:lineSpacingExtra="@dimen/spacing_xs" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
