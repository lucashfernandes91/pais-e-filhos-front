<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/registerScroll" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.CoParent.Auth.Content">

        <include
            layout="@layout/view_auth_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_l" />

        <TextView android:id="@+id/registerStepTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/gray_900" android:textStyle="bold"
            android:accessibilityLiveRegion="polite"
            android:layout_marginBottom="@dimen/spacing_s" />
        <ProgressBar android:id="@+id/registerProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="3" android:progress="1"
            android:importantForAccessibility="no"
            android:layout_marginBottom="@dimen/spacing_m" />

        <LinearLayout android:id="@+id/registerPersonalStep" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
        <!-- First and last name -->
        <LinearLayout
            android:id="@+id/registerNameRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/registerFirstNameColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_s"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.CoParent.Form.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_nome"
                    android:labelFor="@id/etRegFirstName" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.CoParent.Form.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegFirstName"
                        style="@style/Widget.CoParent.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="personGivenName"
                        android:inputType="textPersonName|textCapWords|textAutoCorrect"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/registerLastNameColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.CoParent.Form.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_sobrenome"
                    android:labelFor="@id/etRegLastName" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.CoParent.Form.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegLastName"
                        style="@style/Widget.CoParent.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="personFamilyName"
                        android:inputType="textPersonName|textCapWords|textAutoCorrect"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Birth Date Field -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_data_de_nascimento"
            android:labelFor="@id/etRegBirthDate" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout"
            app:helperText="@string/register_birth_date_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegBirthDate"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="birthDate"
                android:hint="@string/ui_dd_mm_aaaa"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout android:id="@+id/registerAccessStep" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
        <!-- Username Field -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_nome_de_usuario"
            android:labelFor="@id/etRegUsername" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegUsername"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:hint="@string/ui_ex_ana_silva"
                android:inputType="text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email Field -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_email"
            android:labelFor="@id/etRegEmail" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegEmail"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/ui_seu_email_com"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Field -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_senha"
            android:labelFor="@id/etRegPassword" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout"
            app:endIconMode="password_toggle"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegPassword"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/ui_minimo_8_caracteres"
                android:inputType="textPassword"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password Field -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_confirmar_senha"
            android:labelFor="@id/etRegPasswordConfirm" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout.Spaced"
            app:endIconMode="password_toggle"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegPasswordConfirm"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/ui_repita_a_senha"
                android:inputType="textPassword"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout android:id="@+id/registerDeclarationsStep" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbAdultDeclaration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/register_adult_declaration"
            android:textColor="@color/gray_700" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbLegalAcceptance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/register_legal_acceptance_short"
            android:textColor="@color/gray_700" />

        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/register_legal_documents_label" />

        <LinearLayout
            android:id="@+id/registerLegalLinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_s">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvTermsLink"
                style="@style/Widget.CoParent.Button.Text.Compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/register_read_terms"
                android:contentDescription="@string/register_read_terms"
                android:maxLines="2"
                android:ellipsize="none" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvPrivacyLink"
                style="@style/Widget.CoParent.Button.Text.Compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/register_read_privacy"
                android:contentDescription="@string/register_read_privacy"
                android:maxLines="2"
                android:ellipsize="none" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvRegisterError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:layout_marginBottom="@dimen/spacing_m"
            android:background="@drawable/bg_form_feedback_error"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_sm"
            android:textColor="@color/feedback_error_text"
            android:textSize="@dimen/text_size_s"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegisterPrevious"
            style="@style/Widget.CoParent.Button.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/register_previous"
            android:layout_marginBottom="@dimen/spacing_s" />

        <!-- Create Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.CoParent.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_criar_conta"
            android:layout_marginBottom="@dimen/spacing_m" />

        <ProgressBar
            android:id="@+id/registerProgressIndicator"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="@dimen/spacing_m"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary_blue"
            android:alpha="0"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvExistingAccount"
            style="@style/TextAppearance.CoParent.Form.Helper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/register_existing_account"
            android:textColor="@color/primary_blue"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="@dimen/spacing_s" />

    </LinearLayout>
</ScrollView>
