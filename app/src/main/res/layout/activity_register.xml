<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/entry_content_padding_horizontal"
        android:paddingTop="@dimen/entry_navigation_padding_top"
        android:paddingBottom="@dimen/entry_content_padding_bottom">

        <!-- Back navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_l">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.CoParent.TouchTarget.Icon"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back_button"
                android:scaleType="centerInside" />

        </LinearLayout>

        <View
            style="@style/Widget.CoParent.Header.Divider"
            android:layout_marginBottom="@dimen/spacing_l" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_criar_conta"
            android:textSize="@dimen/text_size_xxl"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/auth_title_description_gap"
            android:textColor="@color/gray_900" />

        <!-- Subtitle with benefits -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_comece_a_organizar_a_parentalidade_compartilhada_de_forma"
            android:textSize="15sp"
            android:textColor="@color/gray_600"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="@dimen/auth_header_form_gap"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- First and last name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_s"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.CoParent.InputLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_nome"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.CoParent.TextInputLayout.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegFirstName"
                        style="@style/Widget.CoParent.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.CoParent.InputLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_sobrenome"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.CoParent.TextInputLayout.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegLastName"
                        style="@style/Widget.CoParent.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Username Field -->
        <TextView
            style="@style/TextAppearance.CoParent.InputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_nome_de_usuario"
            android:layout_marginBottom="6dp"
            />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegUsername"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_ex_ana_silva"
                android:inputType="text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Birth Date Field -->
        <TextView
            style="@style/TextAppearance.CoParent.InputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_data_de_nascimento"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegBirthDate"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_dd_mm_aaaa"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email Field -->
        <TextView
            style="@style/TextAppearance.CoParent.InputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_email"
            android:layout_marginBottom="6dp"
            />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegEmail"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_seu_email_com"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Field -->
        <TextView
            style="@style/TextAppearance.CoParent.InputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_senha"
            android:layout_marginBottom="6dp"
            />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:endIconMode="password_toggle"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegPassword"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_minimo_8_caracteres"
                android:inputType="textPassword"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password Field -->
        <TextView
            style="@style/TextAppearance.CoParent.InputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_confirmar_senha"
            android:layout_marginBottom="6dp"
            />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:endIconMode="password_toggle"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegPasswordConfirm"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_repita_a_senha"
                android:inputType="textPassword"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Create Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.CoParent.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_criar_conta"
            android:layout_marginBottom="16dp" />

        <!-- Terms disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_ao_criar_uma_conta_voce_concorda_com_nossos"
            android:textSize="12sp"
            android:textColor="@color/gray_500"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>
</ScrollView>
