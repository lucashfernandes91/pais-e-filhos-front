<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/spacing_s">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="@dimen/message_bubble_side_margin"
        android:orientation="vertical"
        android:background="@drawable/bubble_received"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_s"
        android:paddingBottom="@dimen/spacing_s"
        android:elevation="1dp">

        <!-- Attachment Image -->
        <ImageView
            style="@style/Widget.CoParent.Message.Media"
            android:id="@+id/ivAttachment"
            android:contentDescription="@string/ui_anexo" />

        <!-- Attachment Document Badge -->
        <LinearLayout
            style="@style/Widget.CoParent.Message.DocBadge"
            android:id="@+id/layoutDocBadge"
            android:background="@drawable/bg_doc_badge_light"
            >

            <ImageView
                android:layout_width="@dimen/icon_size_s"
                android:layout_height="@dimen/icon_size_s"
                android:src="@drawable/ic_download"
                app:tint="@color/icon_muted"
                android:layout_marginEnd="@dimen/icon_dot_size_s"
                android:contentDescription="@string/ui_documento" />

            <TextView
                android:id="@+id/tvDocName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_documento"
                android:textSize="@dimen/text_size_xs"
                android:textColor="@color/gray_700" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.CoParent.Message.Body"
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/message_received_text"
            android:lineSpacingExtra="@dimen/stroke_width_emphasis" />

        <TextView
            style="@style/TextAppearance.CoParent.Message.Time"
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/message_time_received"
            android:layout_marginTop="@dimen/spacing_xs" />
    </LinearLayout>
</FrameLayout>
