<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="64dp"
        android:orientation="vertical"
        android:background="@drawable/bubble_received"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:elevation="1dp">

        <!-- Attachment Image -->
        <ImageView
            android:id="@+id/ivAttachment"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginBottom="6dp"
            android:contentDescription="@string/ui_anexo" />

        <!-- Attachment Document Badge -->
        <LinearLayout
            android:id="@+id/layoutDocBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_doc_badge_light"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_download"
                app:tint="@color/icon_muted"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/ui_documento" />

            <TextView
                android:id="@+id/tvDocName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_documento"
                android:textSize="12sp"
                android:textColor="@color/gray_700" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/message_received_text"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/message_time_received"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>
</FrameLayout>
