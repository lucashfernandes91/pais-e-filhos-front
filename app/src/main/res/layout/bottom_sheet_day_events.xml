<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CoParent.Sheet.Content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_l">

    <!-- Drag Handle -->
    <View style="@style/Widget.CoParent.Sheet.Handle" />

    <!-- Header: data do dia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_m">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDaySheetDayName"
                style="@style/TextAppearance.CoParent.Detail.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvDaySheetDate"
                style="@style/TextAppearance.CoParent.Sheet.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />
        </LinearLayout>

        <!-- Badge: quantidade de eventos -->
        <TextView
            android:id="@+id/tvDaySheetCount"
            style="@style/Widget.CoParent.Badge.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_xs"
            android:textColor="@color/primary_blue"
            android:background="@drawable/bg_badge_blue"
            />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_width_thin"
        android:layout_marginStart="@dimen/spacing_l"
        android:layout_marginEnd="@dimen/spacing_l"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:background="@color/gray_200" />

    <!-- Lista de eventos do dia -->
    <LinearLayout
        android:id="@+id/llDayEventsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_l" />

</LinearLayout>
