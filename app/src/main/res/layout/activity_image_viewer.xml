<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.example.chatapp.ZoomableImageView
        android:id="@+id/ivFullImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/btnCloseViewer"
        style="@style/Widget.CoParent.TouchTarget.Icon"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/spacing_sm"
        android:src="@drawable/ic_close"
        app:tint="@android:color/white"
        android:contentDescription="@string/cd_close_image_viewer" />

    <ImageView
        android:id="@+id/btnDownloadViewer"
        style="@style/Widget.CoParent.TouchTarget.Icon"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/spacing_sm"
        android:src="@drawable/ic_download"
        app:tint="@android:color/white"
        android:contentDescription="@string/cd_download_image_button" />

</FrameLayout>
