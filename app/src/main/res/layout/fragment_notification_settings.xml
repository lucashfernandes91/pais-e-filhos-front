<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Top Bar -->
    <LinearLayout
        style="@style/Widget.CoParent.TopBar.Row.Surface">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/gray_900"
            android:contentDescription="@string/cd_back_button" />

        <TextView
            style="@style/TextAppearance.CoParent.TopBar.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_notificacoes"
            android:layout_marginStart="@dimen/spacing_sm" />
    </LinearLayout>

    <View style="@style/Widget.CoParent.Header.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Card: Notificações push -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CoParent.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_m">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_size_m"
                        android:layout_height="@dimen/avatar_size_m"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginEnd="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_badge_size"
                            android:layout_height="@dimen/icon_badge_size"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_notification_bell"
                            app:tint="@color/primary_blue"
                            android:contentDescription="@string/ui_push" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="@dimen/spacing_sm">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_notificacoes_push"
                            android:textSize="@dimen/text_size_m"
                            android:textStyle="bold"
                            android:textColor="@color/gray_900" />

                        <TextView
                            style="@style/TextAppearance.CoParent.List.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_mensagens_e_eventos_importantes"
                            android:layout_marginTop="@dimen/spacing_xs" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPush"
                        style="@style/Widget.CoParent.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Email de backup -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CoParent.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                >

                <LinearLayout
                    style="@style/Widget.CoParent.List.Row">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_size_m"
                        android:layout_height="@dimen/avatar_size_m"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginEnd="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_badge_size"
                            android:layout_height="@dimen/icon_badge_size"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_email_outline"
                            app:tint="@color/primary_blue"
                            android:contentDescription="@string/ui_email" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="@dimen/spacing_sm">

                        <TextView
                            style="@style/TextAppearance.CoParent.List.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_email_de_backup" />

                        <TextView
                            style="@style/TextAppearance.CoParent.List.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_receba_uma_copia_se_o_push_falhar"
                            android:layout_marginTop="@dimen/spacing_xs" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEmailBackup"
                        style="@style/Widget.CoParent.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Modo silencioso noturno -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CoParent.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                >

                <LinearLayout
                    style="@style/Widget.CoParent.List.Row">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_size_m"
                        android:layout_height="@dimen/avatar_size_m"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginEnd="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_badge_size"
                            android:layout_height="@dimen/icon_badge_size"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_night_mode"
                            app:tint="@color/primary_blue"
                            android:contentDescription="@string/ui_modo_noturno" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="@dimen/spacing_sm">

                        <TextView
                            style="@style/TextAppearance.CoParent.List.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_modo_silencioso_noturno" />

                        <TextView
                            style="@style/TextAppearance.CoParent.List.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_sem_notificacoes_entre_22h_e_7h"
                            android:layout_marginTop="@dimen/spacing_xs" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNightMode"
                        style="@style/Widget.CoParent.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
