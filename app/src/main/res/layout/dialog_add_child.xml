<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        style="@style/Widget.CoParent.Form.Content.Compact">

        <!-- Foto da criança -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_m">

            <LinearLayout
                android:id="@+id/btnChildPhoto"
                android:layout_width="@dimen/avatar_size_xl_plus"
                android:layout_height="@dimen/avatar_size_xl_plus"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_avatar_child"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_add_child_photo">

                <ImageView
                    android:id="@+id/ivChildPhoto"
                    android:layout_width="@dimen/avatar_size_xl_plus"
                    android:layout_height="@dimen/avatar_size_xl_plus"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/ivCameraIcon"
                    android:layout_width="@dimen/icon_container_size_xs"
                    android:layout_height="@dimen/icon_container_size_xs"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/gray_400"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvPhotoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_foto"
                    android:textSize="@dimen/text_size_mini"
                    android:textColor="@color/gray_400"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>
        </FrameLayout>

        <!-- Nome -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:text="@string/ui_nome" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChildName"
                style="@style/Widget.CoParent.TextInputEditText"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_nome_do_filho_a"
                android:inputType="textPersonName|textCapWords|textAutoCorrect"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Data de nascimento -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:text="@string/ui_data_de_nascimento" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChildBirthDate"
                style="@style/Widget.CoParent.TextInputEditText"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_data_de_nascimento"
                android:inputType="date"
                android:focusable="true"
                android:clickable="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Checkbox guarda -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbChildLegalDeclaration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/child_legal_declaration"
            android:textColor="@color/gray_700"
            app:buttonTint="@color/primary_blue" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbHasCustody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/ui_possuo_a_guarda_desta_crianca"
            android:textSize="@dimen/text_size_s_plus"
            android:textColor="@color/gray_700"
            app:buttonTint="@color/primary_blue" />

    </LinearLayout>
</ScrollView>
