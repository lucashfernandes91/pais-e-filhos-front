<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Top Bar -->
    <LinearLayout
        style="@style/Widget.CoParent.TopBar.Row.Surface">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/gray_900"
            android:contentDescription="@string/cd_back_button" />

        <TextView
            style="@style/TextAppearance.CoParent.TopBar.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_notificacoes"
            android:layout_marginStart="@dimen/spacing_sm" />

        <ImageView
            android:id="@+id/btnMarkAllRead"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_check"
            app:tint="@color/gray_900"
            android:contentDescription="@string/cd_mark_all_read_button" />

        <ImageView
            android:id="@+id/btnDeleteAllNotifications"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:padding="11dp"
            android:src="@drawable/ic_delete"
            android:scaleType="centerInside"
            app:tint="@color/primary_blue"
            android:contentDescription="@string/cd_clear_all_notifications_button" />

    </LinearLayout>

    <View style="@style/Widget.CoParent.Header.Divider" />

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_l"
        android:accessibilityLiveRegion="polite"
        android:contentDescription="@string/cd_loading_notifications" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/spacing_s" />

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/errorStateNotifications"
        style="@style/Widget.CoParent.State.Container.Fill"
        android:visibility="gone"
        android:padding="@dimen/spacing_xl"
        android:accessibilityLiveRegion="polite"
        android:contentDescription="@string/cd_error_notifications">

        <ImageView
            style="@style/Widget.CoParent.State.Icon.Error"
            android:src="@drawable/ic_error_circle"
            app:tint="@color/error"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/TextAppearance.CoParent.State.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/state_error_title" />

        <TextView
            style="@style/TextAppearance.CoParent.State.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:text="@string/notifications_error_message" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryNotifications"
            style="@style/Widget.CoParent.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/action_try_again" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        style="@style/Widget.CoParent.State.Container.Fill"
        android:visibility="gone"
        android:padding="@dimen/spacing_xl"
        android:accessibilityLiveRegion="polite"
        android:contentDescription="@string/cd_empty_notifications">

        <FrameLayout
            style="@style/Widget.CoParent.State.IconFrame.Empty">

            <ImageView
                android:layout_width="@dimen/icon_size_l"
                android:layout_height="@dimen/icon_size_l"
                android:layout_gravity="center"
                android:src="@drawable/ic_notifications"
                app:tint="@color/primary_blue"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            style="@style/TextAppearance.CoParent.State.EmptyTitle.Emphasis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_tudo_em_dia"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            style="@style/TextAppearance.CoParent.State.EmptyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_nenhuma_notificacao_no_momento" />
    </LinearLayout>
</LinearLayout>
