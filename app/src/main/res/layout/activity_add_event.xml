<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_secondary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.CoParent.TouchTarget.Icon"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_back"
                app:tint="@color/gray_900"
                android:contentDescription="@string/cd_back_button" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_novo_evento"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Título -->
        <View
            style="@style/Widget.CoParent.Header.Divider"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_titulo"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etEventTitle"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/ui_ex_consulta_medica"
            android:textSize="15sp"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_400"
            android:background="@drawable/bg_input_outlined"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:layout_marginBottom="20dp" />

        <!-- Data e Hora (padrão - visível quando NÃO é convivência) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeSingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_data"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_outlined">

                    <EditText
                        android:id="@+id/etEventDate"
                        android:importantForAutofill="no"
                        android:inputType="date"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="15sp"
                        android:textColor="@color/gray_900"
                        android:hint="@string/ui_dd_mm_aaaa"
                        android:paddingStart="16dp"
                        android:paddingEnd="44dp"
                        android:gravity="center_vertical"
                        android:background="@android:color/transparent"
                        android:focusable="true"
                        android:clickable="true" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/gray_500"
                        android:contentDescription="@string/ui_data" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_hora"
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_outlined">

                    <EditText
                        android:id="@+id/etEventTime"
                        android:importantForAutofill="no"
                        android:inputType="time"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="15sp"
                        android:textColor="@color/gray_900"
                        android:hint="@string/ui_18_00"
                        android:paddingStart="16dp"
                        android:paddingEnd="44dp"
                        android:gravity="center_vertical"
                        android:background="@android:color/transparent"
                        android:focusable="true"
                        android:clickable="true" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/gray_500"
                        android:contentDescription="@string/ui_hora" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Data e Hora INÍCIO (visível apenas quando Convivência) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_inicio_da_convivencia"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/gray_700"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_data"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_marginBottom="6dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_outlined">

                        <EditText
                            android:id="@+id/etStartDate"
                            android:importantForAutofill="no"
                            android:inputType="date"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textSize="15sp"
                            android:textColor="@color/gray_900"
                            android:hint="@string/ui_dd_mm_aaaa"
                            android:paddingStart="16dp"
                            android:paddingEnd="44dp"
                            android:gravity="center_vertical"
                            android:background="@android:color/transparent"
                            android:focusable="true"
                            android:clickable="true" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/gray_500"
                            android:contentDescription="@string/ui_data_inicio" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_hora"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_marginBottom="6dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_outlined">

                        <EditText
                            android:id="@+id/etStartTime"
                            android:importantForAutofill="no"
                            android:inputType="time"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textSize="15sp"
                            android:textColor="@color/gray_900"
                            android:hint="@string/ui_18_00"
                            android:paddingStart="16dp"
                            android:paddingEnd="44dp"
                            android:gravity="center_vertical"
                            android:background="@android:color/transparent"
                            android:focusable="true"
                            android:clickable="true" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/gray_500"
                            android:contentDescription="@string/ui_hora_inicio" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Data e Hora FIM (visível apenas quando Convivência) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_fim_da_convivencia"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/gray_700"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_data"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_marginBottom="6dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_outlined">

                        <EditText
                            android:id="@+id/etEndDate"
                            android:importantForAutofill="no"
                            android:inputType="date"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textSize="15sp"
                            android:textColor="@color/gray_900"
                            android:hint="@string/ui_dd_mm_aaaa"
                            android:paddingStart="16dp"
                            android:paddingEnd="44dp"
                            android:gravity="center_vertical"
                            android:background="@android:color/transparent"
                            android:focusable="true"
                            android:clickable="true" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/gray_500"
                            android:contentDescription="@string/ui_data_fim" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_hora"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:layout_marginBottom="6dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_outlined">

                        <EditText
                            android:id="@+id/etEndTime"
                            android:importantForAutofill="no"
                            android:inputType="time"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textSize="15sp"
                            android:textColor="@color/gray_900"
                            android:hint="@string/ui_18_00"
                            android:paddingStart="16dp"
                            android:paddingEnd="44dp"
                            android:gravity="center_vertical"
                            android:background="@android:color/transparent"
                            android:focusable="true"
                            android:clickable="true" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/gray_500"
                            android:contentDescription="@string/ui_hora_fim" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tipo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_tipo"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"
            android:layout_marginBottom="20dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSchool"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_escola"
                app:chipIcon="@drawable/ic_school"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMedical"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_saude"
                app:chipIcon="@drawable/ic_health"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCustody"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_convivencia"
                app:chipIcon="@drawable/ic_custody"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOther"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_outro"
                app:chipIcon="@drawable/ic_other"
                />
        </com.google.android.material.chip.ChipGroup>

        <!-- Notas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_notas_opcional"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etEventNotes"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="@string/ui_detalhes_endereco_observacoes"
            android:textSize="15sp"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_400"
            android:background="@drawable/bg_input_outlined"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="24dp" />

        <!-- Salvar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEvent"
            style="@style/Widget.CoParent.Button.Primary.Pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_salvar_evento"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_o_evento_e_registrado_no_historico_oficial"
            android:textSize="12sp"
            android:textColor="@color/gray_500"
            android:gravity="center"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
