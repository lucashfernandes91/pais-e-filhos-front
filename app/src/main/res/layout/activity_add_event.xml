<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_secondary"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.CoParent.Form.Content"
        android:padding="@dimen/spacing_m">

        <!-- Header -->
        <LinearLayout
            style="@style/Widget.CoParent.Form.Header.Row"
            android:layout_marginBottom="@dimen/spacing_xs">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.CoParent.TouchTarget.Icon"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_back"
                app:tint="@color/gray_900"
                android:contentDescription="@string/cd_back_button" />

            <TextView
                style="@style/TextAppearance.CoParent.Form.HeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_novo_evento"
                android:layout_marginStart="@dimen/spacing_s" />
        </LinearLayout>

        <!-- Título -->
        <View
            style="@style/Widget.CoParent.Header.Divider"
            android:layout_marginBottom="@dimen/spacing_m" />

        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:text="@string/ui_titulo" />

        <EditText
            android:id="@+id/etEventTitle"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_action"
            android:hint="@string/ui_ex_consulta_medica"
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_400"
            android:background="@drawable/bg_input_outlined"
            android:paddingHorizontal="@dimen/spacing_m"
            android:inputType="textCapSentences|textAutoCorrect"
            android:layout_marginBottom="@dimen/spacing_m" />

        <!-- Data e Hora (padrão - visível quando NÃO é convivência) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeSingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_m">

            <LinearLayout
                style="@style/Widget.CoParent.Form.PickerColumn.Start">

                <TextView
                    style="@style/TextAppearance.CoParent.Form.SectionLabel"
                    android:text="@string/ui_data"
                    android:textColor="@color/gray_700" />

                <FrameLayout
                    style="@style/Widget.CoParent.Form.PickerFrame">

                    <EditText
                        android:id="@+id/etEventDate"
                        style="@style/Widget.CoParent.Form.PickerInput"
                        android:importantForAutofill="no"
                        android:inputType="date"
                        android:hint="@string/ui_dd_mm_aaaa"
                        />

                    <ImageView
                        style="@style/Widget.CoParent.Form.PickerTrailingIcon"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/gray_500"
                        android:contentDescription="@string/ui_data" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.CoParent.Form.PickerColumn.End">

                <TextView
                    style="@style/TextAppearance.CoParent.Form.SectionLabel"
                    android:text="@string/ui_hora"
                    android:textColor="@color/gray_700" />

                <FrameLayout
                    style="@style/Widget.CoParent.Form.PickerFrame">

                    <EditText
                        android:id="@+id/etEventTime"
                        style="@style/Widget.CoParent.Form.PickerInput"
                        android:importantForAutofill="no"
                        android:inputType="time"
                        android:hint="@string/ui_18_00"
                        />

                    <ImageView
                        style="@style/Widget.CoParent.Form.PickerTrailingIcon"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/gray_500"
                        android:contentDescription="@string/ui_hora" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Data e Hora INÍCIO (visível apenas quando Convivência) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_m">

            <TextView
                style="@style/TextAppearance.CoParent.Form.PickerGroupTitle"
                android:text="@string/ui_inicio_da_convivencia"
                android:textColor="@color/gray_700" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Widget.CoParent.Form.PickerColumn.Start">

                    <TextView
                        style="@style/TextAppearance.CoParent.Form.SectionLabel"
                        android:text="@string/ui_data"
                        android:textColor="@color/gray_700" />

                    <FrameLayout
                        style="@style/Widget.CoParent.Form.PickerFrame">

                        <EditText
                            android:id="@+id/etStartDate"
                            style="@style/Widget.CoParent.Form.PickerInput"
                            android:importantForAutofill="no"
                            android:inputType="date"
                            android:hint="@string/ui_dd_mm_aaaa"
                            />

                        <ImageView
                            style="@style/Widget.CoParent.Form.PickerTrailingIcon"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/gray_500"
                            android:contentDescription="@string/ui_data_inicio" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.CoParent.Form.PickerColumn.End">

                    <TextView
                        style="@style/TextAppearance.CoParent.Form.SectionLabel"
                        android:text="@string/ui_hora"
                        android:textColor="@color/gray_700" />

                    <FrameLayout
                        style="@style/Widget.CoParent.Form.PickerFrame">

                        <EditText
                            android:id="@+id/etStartTime"
                            style="@style/Widget.CoParent.Form.PickerInput"
                            android:importantForAutofill="no"
                            android:inputType="time"
                            android:hint="@string/ui_18_00"
                            />

                        <ImageView
                            style="@style/Widget.CoParent.Form.PickerTrailingIcon"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/gray_500"
                            android:contentDescription="@string/ui_hora_inicio" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Data e Hora FIM (visível apenas quando Convivência) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_m">

            <TextView
                style="@style/TextAppearance.CoParent.Form.PickerGroupTitle"
                android:text="@string/ui_fim_da_convivencia"
                android:textColor="@color/gray_700" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Widget.CoParent.Form.PickerColumn.Start">

                    <TextView
                        style="@style/TextAppearance.CoParent.Form.SectionLabel"
                        android:text="@string/ui_data"
                        android:textColor="@color/gray_700" />

                    <FrameLayout
                        style="@style/Widget.CoParent.Form.PickerFrame">

                        <EditText
                            android:id="@+id/etEndDate"
                            style="@style/Widget.CoParent.Form.PickerInput"
                            android:importantForAutofill="no"
                            android:inputType="date"
                            android:hint="@string/ui_dd_mm_aaaa"
                            />

                        <ImageView
                            style="@style/Widget.CoParent.Form.PickerTrailingIcon"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/gray_500"
                            android:contentDescription="@string/ui_data_fim" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.CoParent.Form.PickerColumn.End">

                    <TextView
                        style="@style/TextAppearance.CoParent.Form.SectionLabel"
                        android:text="@string/ui_hora"
                        android:textColor="@color/gray_700" />

                    <FrameLayout
                        style="@style/Widget.CoParent.Form.PickerFrame">

                        <EditText
                            android:id="@+id/etEndTime"
                            style="@style/Widget.CoParent.Form.PickerInput"
                            android:importantForAutofill="no"
                            android:inputType="time"
                            android:hint="@string/ui_18_00"
                            />

                        <ImageView
                            style="@style/Widget.CoParent.Form.PickerTrailingIcon"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/gray_500"
                            android:contentDescription="@string/ui_hora_fim" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tipo -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel.Emphasis"
            android:text="@string/ui_tipo" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_m">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSchool"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_escola"
                app:chipIcon="@drawable/ic_school"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMedical"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_saude"
                app:chipIcon="@drawable/ic_health"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCustody"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_convivencia"
                app:chipIcon="@drawable/ic_custody"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOther"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_outro"
                app:chipIcon="@drawable/ic_other"
                />
        </com.google.android.material.chip.ChipGroup>

        <!-- Notas -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:text="@string/ui_notas_opcional" />

        <EditText
            android:id="@+id/etEventNotes"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height_multiline"
            android:hint="@string/ui_detalhes_endereco_observacoes"
            android:textSize="@dimen/text_size_m"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_400"
            android:background="@drawable/bg_input_outlined"
            android:paddingHorizontal="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_sm"
            android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
            android:gravity="top"
            android:layout_marginBottom="@dimen/spacing_m" />

        <!-- Salvar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEvent"
            style="@style/Widget.CoParent.Button.Primary.Pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_salvar_evento"
            />

        <TextView
            style="@style/TextAppearance.CoParent.Form.Helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_o_evento_e_registrado_no_historico_oficial"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_sm" />
    </LinearLayout>
</ScrollView>
