<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Header Normal -->
    <LinearLayout
        android:id="@+id/headerNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical"
        android:background="@color/bg_primary"
        android:elevation="2dp">

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_coparent" />

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_green" />
        </FrameLayout>

        <!-- Name + Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900" />

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_invite_coparent_status"
                android:textSize="12sp"
                android:textColor="@color/gray_400" />
        </LinearLayout>

        <!-- Search button -->
        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_search"
            app:tint="@color/gray_500"
            android:contentDescription="@string/cd_search_button"
            android:layout_marginEnd="4dp" />

        <!-- Export button -->
        <ImageButton
            android:id="@+id/btnExport"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_export"
            app:tint="@color/icon_muted"
            android:contentDescription="@string/cd_export_button" />
    </LinearLayout>

    <!-- Search Bar (hidden by default) -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:background="@color/bg_primary"
        android:elevation="2dp"
        android:visibility="gone">

        <!-- Close button -->
        <ImageButton
            android:id="@+id/btnSearchClose"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/icon_default"
            android:contentDescription="@string/cd_close_search" />

        <!-- Search input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.TextInputLayout.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/icon_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                style="@style/Widget.CoParent.TextInputEditText"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:hint="@string/ui_buscar_na_conversa"
                android:gravity="center_vertical"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Result counter -->
        <TextView
            android:id="@+id/tvSearchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/gray_500"
            android:layout_marginEnd="2dp"
            android:visibility="gone" />

        <!-- Navigate up -->
        <ImageButton
            android:id="@+id/btnSearchUp"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/icon_muted"
            android:contentDescription="@string/cd_previous_search_result"
            android:visibility="gone" />

        <!-- Navigate down -->
        <ImageButton
            android:id="@+id/btnSearchDown"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/icon_muted"
            android:contentDescription="@string/cd_next_search_result"
            android:visibility="gone" />
    </LinearLayout>

    <View style="@style/Widget.CoParent.Header.Divider" />

    <!-- Info Banner -->
    <FrameLayout
        android:id="@+id/infoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/bg_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_info_banner"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/icon_info"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_as_mensagens_sao_registro_oficial_e_nao_podem"
                android:textSize="12sp"
                android:textColor="@color/info_banner_text" />
        </LinearLayout>
    </FrameLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:background="@color/bg_primary" />

    <!-- Error State Chat -->
    <LinearLayout
        android:id="@+id/errorStateChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:background="@color/bg_primary"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite">

        <ImageView
            android:layout_width="@dimen/icon_size_l"
            android:layout_height="@dimen/icon_size_l"
            android:src="@drawable/ic_error_circle"
            app:tint="@color/error"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/state_error_title"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:text="@string/chat_error_message"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryChat"
            style="@style/Widget.CoParent.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/action_try_again" />
    </LinearLayout>

    <!-- Typing Indicator -->
    <TextView
        android:id="@+id/tvTypingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:textSize="13sp"
        android:textColor="@color/gray_500"
        android:textStyle="italic"
        android:background="@color/bg_primary"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <!-- Empty State Chat -->
    <LinearLayout
        android:id="@+id/emptyStateChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:background="@color/bg_primary"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite"
        android:contentDescription="@string/cd_empty_chat">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_chat"
            app:tint="@color/gray_300"
            android:layout_marginBottom="16dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvEmptyChatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_nenhuma_mensagem_ainda"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/gray_700"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvEmptyChatMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_comece_uma_conversa_todas_as_mensagens_ficam_registradas"
            android:textSize="14sp"
            android:textColor="@color/gray_400"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Message Input Bar -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/bg_primary"
        android:elevation="4dp"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Attach button -->
        <ImageButton
            android:id="@+id/btnAttach"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_attach"
            app:tint="@color/gray_500"
            android:contentDescription="@string/cd_attach_button"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/messageInput"
            android:importantForAutofill="no"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_input"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="@string/ui_mensagem"
            android:textSize="15sp"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_400"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:inputType="text|textMultiLine"
            android:maxLines="3"
            android:singleLine="false" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/sendButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_send"
            app:tint="@color/primary_blue"
            app:backgroundTint="@color/send_button_bg"
            app:elevation="0dp"
            app:maxImageSize="20dp"
            android:contentDescription="@string/cd_send_button"
            android:scaleType="centerInside" />
    </LinearLayout>
</LinearLayout>
