<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Header Normal -->
    <LinearLayout
        android:id="@+id/headerNormal"
        style="@style/Widget.CoParent.TopBar.Row.Primary">

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="@dimen/avatar_size_m"
            android:layout_height="@dimen/avatar_size_m"
            android:layout_marginEnd="@dimen/spacing_sm">

            <View
                android:layout_width="@dimen/avatar_size_m"
                android:layout_height="@dimen/avatar_size_m"
                android:background="@drawable/bg_avatar_coparent" />

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text=""
                android:textSize="@dimen/text_size_m"
                android:textStyle="bold"
                android:textColor="@color/secondary_green" />
        </FrameLayout>

        <!-- Name + Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/text_size_ml"
                android:textStyle="bold"
                android:textColor="@color/gray_900" />

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_invite_coparent_status"
                android:textSize="@dimen/text_size_xs"
                android:textColor="@color/gray_500" />
        </LinearLayout>

        <!-- Search button -->
        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_search"
            app:tint="@color/gray_500"
            android:contentDescription="@string/cd_search_button"
            android:layout_marginEnd="@dimen/spacing_xs" />

        <!-- Export button -->
        <ImageButton
            android:id="@+id/btnExport"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_export"
            app:tint="@color/icon_muted"
            android:contentDescription="@string/cd_export_button" />
    </LinearLayout>

    <!-- Search Bar (hidden by default) -->
    <LinearLayout
        android:id="@+id/searchBar"
        style="@style/Widget.CoParent.TopBar.Row.Search"
        android:visibility="gone">

        <!-- Close button -->
        <ImageButton
            android:id="@+id/btnSearchClose"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/icon_default"
            android:contentDescription="@string/cd_close_search" />

        <!-- Search input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.TextInputLayout.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/spacing_xs"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/icon_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                style="@style/Widget.CoParent.TextInputEditText"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="@string/ui_buscar_na_conversa"
                android:gravity="center_vertical"
                android:inputType="text|textCapSentences|textAutoCorrect"
                android:imeOptions="actionSearch"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Result counter -->
        <TextView
            android:id="@+id/tvSearchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_xs"
            android:textColor="@color/gray_600"
            android:layout_marginEnd="@dimen/stroke_width_emphasis"
            android:visibility="gone" />

        <!-- Navigate up -->
        <ImageButton
            android:id="@+id/btnSearchUp"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/icon_muted"
            android:contentDescription="@string/cd_previous_search_result"
            android:visibility="gone" />

        <!-- Navigate down -->
        <ImageButton
            android:id="@+id/btnSearchDown"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/icon_muted"
            android:contentDescription="@string/cd_next_search_result"
            android:visibility="gone" />
    </LinearLayout>

    <View style="@style/Widget.CoParent.Header.Divider" />

    <!-- Info Banner -->
    <FrameLayout
        android:id="@+id/infoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingVertical="@dimen/spacing_s"
        android:background="@color/bg_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_info_banner"
            android:padding="@dimen/spacing_m">

            <ImageView
                android:layout_width="@dimen/icon_size_s"
                android:layout_height="@dimen/icon_size_s"
                android:src="@drawable/ic_shield"
                app:tint="@color/icon_info"
                android:layout_marginEnd="@dimen/spacing_s"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_as_mensagens_sao_registro_oficial_e_nao_podem"
                android:textSize="@dimen/text_size_xs"
                android:textColor="@color/info_banner_text" />
        </LinearLayout>
    </FrameLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:clipToPadding="false"
        android:background="@color/bg_primary" />

    <!-- Error State Chat -->
    <LinearLayout
        android:id="@+id/errorStateChat"
        style="@style/Widget.CoParent.State.Container.Fill"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:background="@color/bg_primary"
        android:accessibilityLiveRegion="polite">

        <ImageView
            style="@style/Widget.CoParent.State.Icon.Error"
            android:src="@drawable/ic_error_circle"
            app:tint="@color/error"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/TextAppearance.CoParent.State.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/state_error_title" />

        <TextView
            style="@style/TextAppearance.CoParent.State.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:text="@string/chat_error_message" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryChat"
            style="@style/Widget.CoParent.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/action_try_again" />
    </LinearLayout>

    <!-- Typing Indicator -->
    <TextView
        android:id="@+id/tvTypingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingVertical="@dimen/spacing_s"
        android:textSize="@dimen/text_size_xs_plus"
        android:textColor="@color/gray_600"
        android:textStyle="italic"
        android:background="@color/bg_primary"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <!-- Empty State Chat -->
    <LinearLayout
        android:id="@+id/emptyStateChat"
        style="@style/Widget.CoParent.State.Container.Fill"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:background="@color/bg_primary"
        android:accessibilityLiveRegion="polite"
        android:contentDescription="@string/cd_empty_chat">

        <ImageView
            style="@style/Widget.CoParent.State.Icon.Empty"
            android:src="@drawable/ic_chat"
            app:tint="@color/gray_300"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvEmptyChatTitle"
            style="@style/TextAppearance.CoParent.State.EmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_nenhuma_mensagem_ainda"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/tvEmptyChatMessage"
            style="@style/TextAppearance.CoParent.State.EmptyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_comece_uma_conversa_todas_as_mensagens_ficam_registradas"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/spacing_xs" />
    </LinearLayout>

    <!-- Message Input Bar -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        android:elevation="@dimen/elevation_medium"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_s"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Attach button -->
        <ImageButton
            android:id="@+id/btnAttach"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_attach"
            app:tint="@color/icon_muted"
            android:contentDescription="@string/cd_attach_button"
            android:layout_marginEnd="@dimen/spacing_xs" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/messageInputLayout"
            style="@style/Widget.CoParent.TextInputLayout.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_s"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/messageInput"
                style="@style/Widget.CoParent.TextInputEditText"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_mensagem"
                android:gravity="center_vertical"
                android:inputType="textCapSentences|textMultiLine|textAutoCorrect"
                android:maxLines="3"
                android:singleLine="false"
                android:contentDescription="@string/cd_chat_message_field" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/sendButton"
            style="@style/Widget.CoParent.TouchTarget.Icon.Primary"
            android:layout_width="@dimen/height_action"
            android:layout_height="@dimen/height_action"
            android:src="@drawable/ic_send"
            app:tint="@color/on_primary"
            android:contentDescription="@string/cd_send_button"
            android:scaleType="centerInside" />
    </LinearLayout>
</LinearLayout>
