<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:paddingBottom="@dimen/spacing_m"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_m">

        <!-- Banner: e-mail não confirmado (A3) -->
        <LinearLayout
            android:id="@+id/bannerVerifyEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_info_banner"
            android:paddingHorizontal="@dimen/spacing_m"
            android:paddingVertical="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/email_verify_banner_title"
                    android:textSize="@dimen/text_size_s"
                    android:textStyle="bold"
                    android:textColor="@color/info_banner_text" />

                <TextView
                    android:id="@+id/tvVerifyEmailMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textSize="@dimen/text_size_xs"
                    android:textColor="@color/info_banner_text" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyEmail"
                style="@style/Widget.CoParent.Button.Text.Compact"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/spacing_s"
                android:text="@string/email_verify_banner_action"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/spacing_sm" />
        </LinearLayout>

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_xl"
                    android:textStyle="bold"
                    android:textColor="@color/gray_900"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_s"
                    android:textColor="@color/gray_500"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>

            <!-- Notification Button -->
            <FrameLayout
                android:id="@+id/btnNotifications"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:background="@drawable/bg_notification_button"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:foreground="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_notification_button">

                <ImageView
                    android:layout_width="@dimen/icon_notification_size"
                    android:layout_height="@dimen/icon_notification_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification_bell"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <!-- Badge com contador (visível apenas quando houver notificações) -->
                <TextView
                    android:id="@+id/tvNotificationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/notification_badge_size"
                    android:minHeight="@dimen/notification_badge_size"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:textSize="@dimen/text_size_mini"
                    android:textColor="@color/on_error"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <View
            style="@style/Widget.CoParent.Header.Divider"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- Current Care Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CoParent.Card.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingVertical="@dimen/spacing_s">

                <!-- Header com registro legal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCustodyHeaderLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_guarda_atual"
                        android:textSize="@dimen/text_size_xs"
                        android:textColor="@color/on_primary"
                        android:alpha="0.8"
                        android:letterSpacing="0.08" />

                    <!-- Selo Registro Legal -->
                    <LinearLayout
                        android:id="@+id/custodyLegalBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xs"
                        android:background="@drawable/bg_badge_legal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/icon_size_xxs"
                            android:layout_height="@dimen/icon_size_xxs"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/on_primary"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:contentDescription="@string/ui_registro" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_registro_legal"
                            android:textSize="@dimen/text_size_xs"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCustodyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_custody_loading"
                    android:textSize="@dimen/text_size_xl"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Linha divisória -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_width_thin"
                    android:background="@color/on_primary"
                    android:alpha="0.15"
                    android:layout_marginVertical="@dimen/spacing_s" />

                <!-- Seção Próxima Troca -->
                <TextView
                    android:id="@+id/tvNextSwapLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_proxima_troca"
                    android:textSize="@dimen/text_size_xs"
                    android:textColor="@color/on_primary"
                    android:alpha="0.7"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_xs">

                    <TextView
                    android:id="@+id/tvNextSwapDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_custody_loading_detail"
                    android:textSize="@dimen/text_size_m"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary"
                    android:maxLines="2"
                    android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_sm">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNewMessage"
                style="@style/Widget.CoParent.Card.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_quick_action_message"
                android:foreground="?selectableItemBackground"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_m"
                    android:paddingVertical="@dimen/spacing_s"
                    android:gravity="start">

                    <!-- Ícone de mensagem em azul -->
                    <FrameLayout
                        android:layout_width="@dimen/icon_container_size_m"
                        android:layout_height="@dimen/icon_container_size_m"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginBottom="@dimen/spacing_s">

                        <ImageView
                            android:layout_width="@dimen/icon_size_m"
                            android:layout_height="@dimen/icon_size_m"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/primary_blue"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_enviar_mensagem"
                        android:textSize="@dimen/text_size_m"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvMessageTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_invite_parent"
                        android:textSize="@dimen/text_size_s"
                        android:textColor="@color/gray_500"
                        android:lineSpacingExtra="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNewEvent"
                style="@style/Widget.CoParent.Card.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_quick_action_event"
                android:foreground="?selectableItemBackground"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_m"
                    android:paddingVertical="@dimen/spacing_s"
                    android:gravity="start">

                    <!-- Ícone de calendário em azul -->
                    <FrameLayout
                        android:layout_width="@dimen/icon_container_size_m"
                        android:layout_height="@dimen/icon_container_size_m"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginBottom="@dimen/spacing_s">

                        <ImageView
                            android:layout_width="@dimen/icon_size_m"
                            android:layout_height="@dimen/icon_size_m"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_calendar_add_outline"
                            app:tint="@color/primary_blue_light"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_agendar_evento"
                        android:textSize="@dimen/text_size_m"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="@dimen/spacing_xs"
                        android:text="@string/ui_escola_saude_custodia"
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_size_s" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Header Próximos Eventos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_proximos_eventos"
                android:textSize="@dimen/text_size_l"
                android:textStyle="bold"
                android:textColor="@color/gray_900" />

            <TextView
                android:id="@+id/btnViewAgenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_ver_agenda"
                android:textSize="@dimen/text_size_s"
                android:textColor="@color/primary_blue"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/touch_target_min"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_s"
                android:foreground="?selectableItemBackground" />
        </LinearLayout>

        <!-- Events Container (each event is its own card) -->
        <LinearLayout
            android:id="@+id/eventsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Skeleton Loading -->
        <include
            android:id="@+id/skeletonHome"
            layout="@layout/skeleton_list"
            android:visibility="visible"
            android:importantForAccessibility="noHideDescendants" />

        <!-- Footer removed: duplicated info from guarda card above. Keep only in onboarding. -->
    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
