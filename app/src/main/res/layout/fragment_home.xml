<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:paddingBottom="80dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_ola_ana"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_900"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_domingo_26_de_abril"
                    android:textSize="14sp"
                    android:textColor="@color/gray_500"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Notification Button -->
            <FrameLayout
                android:id="@+id/btnNotifications"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_notification_button"
                android:foreground="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_notification_button">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification_bell"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <!-- Badge com contador (visível apenas quando houver notificações) -->
                <TextView
                    android:id="@+id/tvNotificationBadge"
                    style="@style/Widget.CoParent.Badge.Label"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="-2dp"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="@color/on_error"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <View
            style="@style/Widget.CoParent.Header.Divider"
            android:layout_marginStart="-20dp"
            android:layout_marginEnd="-20dp"
            android:layout_marginBottom="20dp" />

        <!-- Current Care Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CoParent.Card.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header com registro legal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCustodyHeaderLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_guarda_atual"
                        android:textSize="12sp"
                        android:textColor="@color/on_primary"
                        android:alpha="0.8"
                        android:letterSpacing="0.08" />

                    <!-- Selo Registro Legal -->
                    <LinearLayout
                        android:id="@+id/custodyLegalBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_badge_legal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/on_primary"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/ui_registro" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_registro_legal"
                            android:textSize="12sp"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCustodyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_custody_loading"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Linha divisória -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/on_primary"
                    android:alpha="0.15"
                    android:layout_marginVertical="12dp" />

                <!-- Seção Próxima Troca -->
                <TextView
                    android:id="@+id/tvNextSwapLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_proxima_troca"
                    android:textSize="12sp"
                    android:textColor="@color/on_primary"
                    android:alpha="0.7"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                    android:id="@+id/tvNextSwapDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_custody_loading_detail"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary"
                    android:maxLines="2"
                    android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNewMessage"
                style="@style/Widget.CoParent.Card.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_quick_action_message"
                android:foreground="?selectableItemBackground"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="start">

                    <!-- Ícone de mensagem em azul -->
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_nav_messages_source"
                            app:tint="@color/primary_blue"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_enviar_mensagem"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        android:layout_marginBottom="4dp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvMessageTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_invite_parent"
                        android:textSize="13sp"
                        android:textColor="@color/gray_500"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNewEvent"
                style="@style/Widget.CoParent.Card.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_quick_action_event"
                android:foreground="?selectableItemBackground"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="start">

                    <!-- Ícone de calendário em azul -->
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_calendar_add_outline"
                            app:tint="@color/primary_blue_light"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_agendar_evento"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        android:layout_marginBottom="4dp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/ui_escola_saude_custodia"
                        android:textColor="@color/gray_500"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Header Próximos Eventos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_proximos_eventos"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900" />

            <TextView
                android:id="@+id/btnViewAgenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_ver_agenda"
                android:textSize="14sp"
                android:textColor="@color/primary_blue"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/touch_target_min"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_s"
                android:foreground="?selectableItemBackground" />
        </LinearLayout>

        <!-- Events Container (each event is its own card) -->
        <LinearLayout
            android:id="@+id/eventsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- Skeleton Loading -->
        <include
            android:id="@+id/skeletonHome"
            layout="@layout/skeleton_list"
            android:visibility="visible"
            android:importantForAccessibility="noHideDescendants" />

        <!-- Footer removed: duplicated info from guarda card above. Keep only in onboarding. -->
    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
