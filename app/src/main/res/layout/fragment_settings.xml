<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <!-- Header -->
        <TextView
            style="@style/TextStyle.Display2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações" />

        <!-- Outro Responsável Section -->
        <TextView
            style="@style/TextStyle.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUTRO RESPONSÁVEL"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:textColor="@color/gray_500"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_m" />

        <!-- Outro Responsável - Com dados -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOtherParent"
            style="@style/CardStyle.Base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_l"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                android:gravity="center_vertical">

                <!-- Avatar -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/spacing_m">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_avatar_circle_outline" />

                    <TextView
                        android:id="@+id/tvOtherParentInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="L"
                        android:gravity="center"
                        android:textColor="@color/gray_700"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                </FrameLayout>

                <!-- Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOtherParentName"
                        style="@style/TextStyle.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lucas"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOtherParentRole"
                        style="@style/TextStyle.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pai \u00B7 Conectado"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Status Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_badge_active">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_green"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ativo"
                        android:textSize="11sp"
                        android:textColor="@color/secondary_green"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Outro Responsável - Convidar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInviteParent"
            style="@style/CardStyle.Base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_l"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_circle_green"
                    android:layout_marginEnd="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:tint="@color/secondary_green"
                        android:contentDescription="Convidar" />
                </FrameLayout>

                <TextView
                    style="@style/TextStyle.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Convidar outro responsável" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=">"
                    android:textSize="18sp"
                    android:textColor="@color/gray_400" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notifications Section -->
        <TextView
            style="@style/TextStyle.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notificações"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_m" />

        <com.google.android.material.card.MaterialCardView
            style="@style/CardStyle.Base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Push Notifications Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextStyle.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notificações Push" />

                        <TextView
                            style="@style/TextStyle.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mensagens em tempo real"
                            android:layout_marginTop="@dimen/spacing_xs" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPushNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    style="@style/Divider"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <!-- Email Notifications Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextStyle.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notificações por Email" />

                        <TextView
                            style="@style/TextStyle.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resumo diário"
                            android:layout_marginTop="@dimen/spacing_xs" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEmailNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Privacidade & Dados Section -->
        <TextView
            style="@style/TextStyle.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIVACIDADE &amp; DADOS"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:textColor="@color/gray_500"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_m" />

        <com.google.android.material.card.MaterialCardView
            style="@style/CardStyle.Base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Exportar todos os dados -->
                <LinearLayout
                    android:id="@+id/btnExportData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m"
                    android:gravity="center_vertical"
                    android:foreground="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginEnd="@dimen/spacing_m">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_download"
                            app:tint="@color/primary_blue"
                            android:contentDescription="Exportar" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextStyle.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exportar todos os dados"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextStyle.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PDF com mensagens e eventos"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textSize="18sp"
                        android:textColor="@color/gray_400" />
                </LinearLayout>

                <View
                    style="@style/Divider"
                    android:layout_width="match_parent"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <!-- Privacidade -->
                <LinearLayout
                    android:id="@+id/btnPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m"
                    android:gravity="center_vertical"
                    android:foreground="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginEnd="@dimen/spacing_m">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/primary_blue"
                            android:contentDescription="Privacidade" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextStyle.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Privacidade"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextStyle.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Como tratamos seus dados"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textSize="18sp"
                        android:textColor="@color/gray_400" />
                </LinearLayout>

                <View
                    style="@style/Divider"
                    android:layout_width="match_parent"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <!-- Validade jurídica -->
                <LinearLayout
                    android:id="@+id/btnLegal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m"
                    android:gravity="center_vertical"
                    android:foreground="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginEnd="@dimen/spacing_m">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/primary_blue"
                            android:contentDescription="Validade" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextStyle.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Validade jurídica"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextStyle.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Como funciona o registro oficial"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textSize="18sp"
                        android:textColor="@color/gray_400" />
                </LinearLayout>

                <View
                    style="@style/Divider"
                    android:layout_width="match_parent"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="@dimen/spacing_m" />

                <!-- Ajuda & Suporte -->
                <LinearLayout
                    android:id="@+id/btnSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m"
                    android:gravity="center_vertical"
                    android:foreground="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginEnd="@dimen/spacing_m">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_info_circle"
                            app:tint="@color/primary_blue"
                            android:contentDescription="Ajuda" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextStyle.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ajuda &amp; Suporte"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=">"
                        android:textSize="18sp"
                        android:textColor="@color/gray_400" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sair da conta -->
        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:foreground="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_logout"
                app:tint="@color/gray_600"
                android:layout_marginEnd="8dp"
                android:contentDescription="Sair" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sair da conta"
                android:textSize="14sp"
                android:textColor="@color/gray_600" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CoParent Lite \u00B7 v1.0"
            android:textSize="12sp"
            android:textColor="@color/gray_400"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_l" />
    </LinearLayout>
</ScrollView>
