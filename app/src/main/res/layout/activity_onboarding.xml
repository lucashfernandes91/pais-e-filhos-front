<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/surface_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/pageContent"
            style="@style/Widget.CoParent.Onboarding.PageContent">

            <FrameLayout
                style="@style/Widget.CoParent.Onboarding.Hero">

                <ImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="@dimen/onboarding_hero_icon_size"
                    android:layout_height="@dimen/onboarding_hero_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                style="@style/TextAppearance.CoParent.Onboarding.Title"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/onboarding_title_description_gap"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/stroke_width_emphasis"
                android:maxLines="1"
                />

            <TextView
                style="@style/TextAppearance.CoParent.Onboarding.Body"
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/spacing_xs"
                android:maxWidth="@dimen/onboarding_page_max_width" />
        </LinearLayout>

        <!-- Bottom area: dots + buttons -->
        <LinearLayout
            android:id="@+id/bottomActions"
            style="@style/Widget.CoParent.Onboarding.BottomActions">

            <LinearLayout
                android:id="@+id/dotsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/onboarding_dots_gap"
                android:orientation="horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.CoParent.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/ui_continuar" />

            <TextView
                android:id="@+id/btnSkip"
                style="@style/Widget.CoParent.Onboarding.Skip"
                android:text="@string/ui_pular_introducao"
                />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnBack"
        style="@style/Widget.CoParent.TouchTarget.Icon"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/entry_content_padding_horizontal"
        android:layout_marginTop="@dimen/entry_navigation_padding_top"
        android:contentDescription="@string/onboarding_back"
        android:src="@drawable/ic_arrow_back"
        android:visibility="gone"
        app:tint="@color/icon_default" />
</FrameLayout>
