<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Widget.CoParent.Auth.Content">

        <include
            layout="@layout/view_auth_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auth_header_form_gap" />

        <!-- Email/Username Field -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_usuario_ou_email"
            android:labelFor="@id/etEmail" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:hint="@string/ui_ex_ana_silva"
                android:inputType="text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Field -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_senha"
            android:labelFor="@id/etPassword" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/ui_sua_senha"
                android:inputType="textPassword"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvForgotPasswordLink"
            style="@style/Widget.CoParent.Button.Text.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/ui_esqueci_minha_senha"
            android:layout_marginBottom="@dimen/spacing_s" />

        <TextView
            android:id="@+id/tvLoginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_m"
            android:background="@drawable/bg_form_feedback_error"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/login_error_invalid_credentials"
            android:textColor="@color/feedback_error_text"
            android:textSize="@dimen/text_size_s"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryConversation"
            style="@style/Widget.CoParent.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_retry_conversation"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_m" />

        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.CoParent.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_entrar"
            android:layout_marginBottom="@dimen/spacing_s" />

        <!-- Divider with text -->
        <LinearLayout
            style="@style/Widget.CoParent.Divider.Labeled.Row.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="@dimen/spacing_xs">

            <View
                style="@style/Widget.CoParent.Divider.Labeled.Line"
                android:background="@color/gray_300" />

            <TextView
                style="@style/TextAppearance.CoParent.DividerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_ou"
                android:paddingHorizontal="@dimen/spacing_sm" />

            <View
                style="@style/Widget.CoParent.Divider.Labeled.Line"
                android:background="@color/gray_300" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvCreateAccount"
            style="@style/Widget.CoParent.Button.Text.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/ui_criar_nova_conta"
            />
    </LinearLayout>
</ScrollView>
