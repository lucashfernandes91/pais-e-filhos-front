<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/entry_content_padding_horizontal"
        android:paddingVertical="@dimen/entry_content_padding_bottom">

        <!-- App Icon/Logo -->
        <FrameLayout
            android:layout_width="@dimen/auth_hero_icon_container_size"
            android:layout_height="@dimen/auth_hero_icon_container_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/auth_hero_icon_title_gap"
            android:background="@drawable/bg_icon_circle_blue">

            <ImageView
                android:layout_width="@dimen/auth_hero_icon_size"
                android:layout_height="@dimen/auth_hero_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield"
                app:tint="@color/on_primary"
                android:contentDescription="@string/ui_coparent_logo" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_coparent_lite"
            android:textSize="@dimen/text_size_xxl"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/auth_title_description_gap"
            android:textColor="@color/gray_900" />

        <!-- Subtitle/tagline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_organize_a_guarda_compartilhada_sem_conflitos"
            android:textSize="@dimen/text_size_s_plus"
            android:gravity="center"
            android:textColor="@color/gray_600"
            android:lineSpacingExtra="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/auth_header_form_gap"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Email/Username Field -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_usuario_ou_email" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_ex_ana_silva"
                android:inputType="text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Field -->
        <TextView
            style="@style/TextAppearance.CoParent.Form.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_senha" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CoParent.Form.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                style="@style/Widget.CoParent.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ui_sua_senha"
                android:inputType="textPassword"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvForgotPasswordLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/ui_esqueci_minha_senha"
            android:textColor="@color/primary_blue"
            android:textSize="@dimen/text_size_s_plus"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_s" />

        <TextView
            android:id="@+id/tvLoginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_m"
            android:background="@drawable/bg_form_feedback_error"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/login_error_invalid_credentials"
            android:textColor="@color/feedback_error_text"
            android:textSize="@dimen/text_size_s"
            android:visibility="gone" />

        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.CoParent.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_entrar"
            android:layout_marginBottom="@dimen/spacing_m" />

        <!-- Divider with text -->
        <LinearLayout
            style="@style/Widget.CoParent.Divider.Labeled.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:layout_marginBottom="@dimen/spacing_m">

            <View
                style="@style/Widget.CoParent.Divider.Labeled.Line"
                android:background="@color/gray_300" />

            <TextView
                style="@style/TextAppearance.CoParent.DividerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_ou"
                android:paddingHorizontal="@dimen/spacing_sm" />

            <View
                style="@style/Widget.CoParent.Divider.Labeled.Line"
                android:background="@color/gray_300" />
        </LinearLayout>

        <!-- Create Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvCreateAccount"
            style="@style/Widget.CoParent.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_criar_nova_conta"
            />
    </LinearLayout>
</ScrollView>
