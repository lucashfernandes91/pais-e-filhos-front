<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:background="@color/bg_secondary">

    <LinearLayout
        style="@style/Widget.CoParent.Form.Content.Compact"
        android:background="@color/bg_secondary"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_m">

        <!-- Header -->
        <LinearLayout
            style="@style/Widget.CoParent.Form.Header.Row"
            android:layout_marginBottom="@dimen/spacing_s">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.CoParent.TouchTarget.Icon"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_back"
                app:tint="@color/gray_900"
                android:contentDescription="@string/cd_event_sheet_back" />

            <TextView
                style="@style/TextAppearance.CoParent.Form.HeaderTitle"
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_novo_evento"
                android:layout_marginStart="@dimen/spacing_s" />
        </LinearLayout>

        <!-- Título -->
        <TextView
            android:id="@+id/lblEventTitle"
            style="@style/TextStyle.EventFormLabel"
            android:text="@string/event_label_title" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEventTitle"
            style="@style/Widget.CoParent.TextInputLayout.Event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEventTitle"
                style="@style/Widget.CoParent.TextInputEditText.Event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/event_placeholder_title"
                android:inputType="textCapSentences|textAutoCorrect"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Data e Hora (pickers — visível quando NÃO é convivência) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeSingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/containerEventDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_weight="1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEventDate"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/containerEventTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_weight="1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEventTime"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <!-- Data e Hora INÍCIO (visível apenas quando Convivência selecionado) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_sm">

            <TextView
                style="@style/TextAppearance.CoParent.Form.SectionLabel.Emphasis"
                android:text="@string/ui_inicio_da_convivencia" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/containerStartDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStartDate"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/containerStartTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStartTime"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Data e Hora FIM (visível apenas quando Convivência selecionado) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_sm">

            <TextView
                style="@style/TextAppearance.CoParent.Form.SectionLabel.Emphasis"
                android:text="@string/ui_fim_da_convivencia" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/containerEndDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEndDate"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/containerEndTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEndTime"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tipo -->
        <TextView
            android:id="@+id/lblEventType"
            style="@style/TextStyle.EventFormLabel"
            android:layout_marginBottom="@dimen/spacing_s"
            android:text="@string/event_label_type" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:chipSpacingHorizontal="@dimen/spacing_s"
            app:chipSpacingVertical="@dimen/spacing_xs"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSchool"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_escola" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMedical"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_saude" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCustody"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_conviv" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOther"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_outro" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Notas -->
        <TextView
            android:id="@+id/lblEventNotes"
            style="@style/TextStyle.EventFormLabel"
            android:text="@string/event_label_notes" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEventNotes"
            style="@style/Widget.CoParent.TextInputLayout.Event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEventNotes"
                style="@style/Widget.CoParent.TextInputEditText.Event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/event_placeholder_notes"
                android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Feedback: loading / success / error -->
        <LinearLayout
            android:id="@+id/bannerFormFeedback"
            style="@style/Widget.CoParent.Form.FeedbackBanner"
            android:accessibilityLiveRegion="polite">

            <ProgressBar
                android:id="@+id/progressFormFeedback"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:layout_marginEnd="@dimen/spacing_s"
                android:indeterminateTint="@color/primary_blue"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivFormFeedback"
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:layout_marginEnd="@dimen/spacing_s"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFormFeedback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_size_s" />
        </LinearLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEvent"
            style="@style/Widget.CoParent.Button.Primary.Pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_salvar_evento"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_o_evento_e_registrado_no_historico_oficial"
            android:textSize="@dimen/text_size_xs"
            android:textColor="@color/gray_500"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
