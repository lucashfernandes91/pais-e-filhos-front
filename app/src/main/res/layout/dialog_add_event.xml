<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_secondary"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.CoParent.TouchTarget.Icon"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_back"
                app:tint="@color/gray_900"
                android:contentDescription="@string/cd_event_sheet_back" />

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_novo_evento"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Título -->
        <TextView
            android:id="@+id/lblEventTitle"
            style="@style/TextStyle.EventFormLabel"
            android:text="@string/event_label_title" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEventTitle"
            style="@style/Widget.CoParent.TextInputLayout.Event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEventTitle"
                style="@style/Widget.CoParent.TextInputEditText.Event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/event_placeholder_title"
                android:inputType="text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Data e Hora (pickers — visível quando NÃO é convivência) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeSingle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/containerEventDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/containerEventTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Data e Hora INÍCIO (visível apenas quando Convivência selecionado) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_inicio_da_convivencia"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/gray_700"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/containerStartDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/containerStartTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Data e Hora FIM (visível apenas quando Convivência selecionado) -->
        <LinearLayout
            android:id="@+id/layoutDateTimeEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_fim_da_convivencia"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/gray_700"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/containerEndDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/containerEndTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tipo -->
        <TextView
            android:id="@+id/lblEventType"
            style="@style/TextStyle.EventFormLabel"
            android:layout_marginBottom="8dp"
            android:text="@string/event_label_type" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/segmentEventType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/segSchool"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_escola" />

            <com.google.android.material.chip.Chip
                android:id="@+id/segMedical"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_saude" />

            <com.google.android.material.chip.Chip
                android:id="@+id/segCustody"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_conviv" />

            <com.google.android.material.chip.Chip
                android:id="@+id/segOther"
                style="@style/Widget.CoParent.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_outro" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Notas -->
        <TextView
            android:id="@+id/lblEventNotes"
            style="@style/TextStyle.EventFormLabel"
            android:text="@string/event_label_notes" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEventNotes"
            style="@style/Widget.CoParent.TextInputLayout.Event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEventNotes"
                style="@style/Widget.CoParent.TextInputEditText.Event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/event_placeholder_notes"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Feedback: loading / success / error -->
        <LinearLayout
            android:id="@+id/bannerFormFeedback"
            style="@style/Widget.CoParent.Feedback.Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite">

            <ProgressBar
                android:id="@+id/progressFormFeedback"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="@color/primary_blue"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivFormFeedback"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFormFeedback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEvent"
            style="@style/Widget.CoParent.Button.Primary.Pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_salvar_evento"
            android:layout_marginBottom="8dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_o_evento_e_registrado_no_historico_oficial"
            android:textSize="12sp"
            android:textColor="@color/gray_500"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
