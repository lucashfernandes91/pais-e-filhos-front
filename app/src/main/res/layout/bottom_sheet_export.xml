<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CoParent.Sheet.Content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_xl">

    <!-- Handle bar -->
    <View style="@style/Widget.CoParent.Sheet.Handle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvExportTitle"
        style="@style/TextAppearance.CoParent.Sheet.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:text="@string/ui_exportar_conversa" />

    <!-- Subtitle -->
    <TextView
        style="@style/TextAppearance.CoParent.Sheet.Body"
        android:id="@+id/tvExportInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/ui_gera_um_pdf_com_registro_oficial_de_todas"
        android:lineSpacingExtra="@dimen/stroke_width_emphasis" />

    <!-- Info card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.CoParent.Card.Info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_l"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <!-- Messages count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_s">

                <ImageView
                    android:id="@+id/ivExportIcon"
                    android:layout_width="@dimen/icon_size_s"
                    android:layout_height="@dimen/icon_size_s"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/primary_blue"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/ui_mensagens" />

                <TextView
                    style="@style/TextAppearance.CoParent.Sheet.Info"
                    android:id="@+id/tvMessageCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_0_mensagens" />
            </LinearLayout>

            <!-- Legal badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/icon_size_s"
                    android:layout_height="@dimen/icon_size_s"
                    android:src="@drawable/ic_shield"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:contentDescription="@string/ui_registro" />

                <TextView
                    style="@style/TextAppearance.CoParent.Sheet.Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_valido_para_fins_legais" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Download button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownloadPdf"
        style="@style/Widget.CoParent.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="@string/ui_baixar_pdf"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconTint="@color/on_primary"
        app:iconSize="@dimen/icon_badge_size"
        app:iconPadding="@dimen/spacing_s" />

    <!-- Share button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePdf"
        style="@style/Widget.CoParent.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="@string/ui_compartilhar"
        app:icon="@drawable/ic_export"
        app:iconGravity="textStart"
        app:iconTint="@color/primary_blue"
        app:iconSize="@dimen/icon_badge_size"
        app:iconPadding="@dimen/spacing_s" />

    <!-- Progress -->
    <LinearLayout
        android:id="@+id/progressContainer"
        style="@style/Widget.CoParent.Feedback.Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="@dimen/spacing_m"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="@dimen/icon_badge_size"
            android:layout_height="@dimen/icon_badge_size"
            android:indeterminate="true"
            app:indicatorColor="@color/primary_blue"
            app:indicatorSize="@dimen/icon_badge_size"
            app:trackThickness="@dimen/stroke_width_emphasis" />

        <TextView
            style="@style/TextAppearance.CoParent.Sheet.Body"
            android:id="@+id/tvProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:text="@string/ui_gerando_pdf" />
</LinearLayout>
</LinearLayout>
