<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingBottom="32dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_handle_bar" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="Exportar conversa"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/gray_900" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvExportInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:text="Gera um PDF com registro oficial de todas as mensagens e eventos."
        android:textSize="13sp"
        android:textColor="@color/gray_500"
        android:lineSpacingExtra="2dp" />

    <!-- Info card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#F0F5FF"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Messages count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/primary_blue"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Mensagens" />

                <TextView
                    android:id="@+id/tvMessageCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 mensagens"
                    android:textSize="13sp"
                    android:textColor="@color/gray_700" />
            </LinearLayout>

            <!-- Legal badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Registro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Válido para fins legais"
                    android:textSize="13sp"
                    android:textColor="@color/gray_700" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Download button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownloadPdf"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:text="Baixar PDF"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primary_blue"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:iconSize="20dp"
        app:iconPadding="8dp" />

    <!-- Share button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePdf"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:text="Compartilhar"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:textColor="@color/primary_blue"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:cornerRadius="12dp"
        app:strokeColor="@color/primary_blue"
        app:strokeWidth="1.5dp"
        app:icon="@drawable/ic_export"
        app:iconGravity="textStart"
        app:iconTint="@color/primary_blue"
        app:iconSize="20dp"
        app:iconPadding="8dp" />

    <!-- Progress -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            app:indicatorColor="@color/primary_blue"
            app:indicatorSize="20dp"
            app:trackThickness="2dp" />

        <TextView
            android:id="@+id/tvProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Gerando PDF..."
            android:textSize="13sp"
            android:textColor="@color/gray_500" />
    </LinearLayout>
</LinearLayout>
