<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CoParent.Sheet.Content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="32dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_handle_bar" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="@string/ui_exportar_conversa"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/gray_900" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvExportInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:text="@string/ui_gera_um_pdf_com_registro_oficial_de_todas"
        android:textSize="13sp"
        android:textColor="@color/gray_500"
        android:lineSpacingExtra="2dp" />

    <!-- Info card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.CoParent.Card.Info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Messages count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/primary_blue"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/ui_mensagens" />

                <TextView
                    android:id="@+id/tvMessageCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_0_mensagens"
                    android:textSize="13sp"
                    android:textColor="@color/gray_700" />
            </LinearLayout>

            <!-- Legal badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/ui_registro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_valido_para_fins_legais"
                    android:textSize="13sp"
                    android:textColor="@color/gray_700" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Download button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownloadPdf"
        style="@style/Widget.CoParent.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:text="@string/ui_baixar_pdf"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconTint="@color/on_primary"
        app:iconSize="20dp"
        app:iconPadding="8dp" />

    <!-- Share button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePdf"
        style="@style/Widget.CoParent.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:text="@string/ui_compartilhar"
        app:icon="@drawable/ic_export"
        app:iconGravity="textStart"
        app:iconTint="@color/primary_blue"
        app:iconSize="20dp"
        app:iconPadding="8dp" />

    <!-- Progress -->
    <LinearLayout
        android:id="@+id/progressContainer"
        style="@style/Widget.CoParent.Feedback.Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            app:indicatorColor="@color/primary_blue"
            app:indicatorSize="20dp"
            app:trackThickness="2dp" />

        <TextView
            android:id="@+id/tvProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/ui_gerando_pdf"
            android:textSize="13sp"
            android:textColor="@color/gray_500" />
    </LinearLayout>
</LinearLayout>
