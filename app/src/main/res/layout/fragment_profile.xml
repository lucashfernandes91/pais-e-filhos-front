<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_m"
        android:paddingBottom="@dimen/screen_content_bottom_padding">

        <!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_perfil"
            android:textSize="@dimen/text_size_xl"
            android:textStyle="bold"
            android:textColor="@color/gray_900"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <View
            style="@style/Widget.CoParent.Header.Divider"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            android:layout_marginBottom="@dimen/spacing_l" />

        <!-- User Card — main profile with editable avatar -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CoParent.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_m"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="@dimen/avatar_size_xl"
                    android:layout_height="@dimen/avatar_size_xl"
                    android:layout_marginEnd="@dimen/spacing_m"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_avatar"
                    android:background="?selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_size_xl"
                        android:layout_height="@dimen/avatar_size_xl"
                        android:background="@drawable/bg_avatar_user">

                        <ImageView
                            android:id="@+id/ivProfilePhoto"
                            android:layout_width="@dimen/avatar_size_xl"
                            android:layout_height="@dimen/avatar_size_xl"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvUserAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="@dimen/text_size_xl"
                            android:textStyle="bold"
                            android:textColor="@color/primary_blue"
                            android:text="@string/ui_a" />
                    </FrameLayout>

                    <!-- Camera badge — edit avatar -->
                    <FrameLayout
                        android:layout_width="@dimen/icon_size_m"
                        android:layout_height="@dimen/icon_size_m"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-2dp"
                        android:layout_marginBottom="-2dp"
                        android:background="@drawable/bg_badge_camera">

                        <ImageView
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/on_primary"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_ana"
                        android:textSize="@dimen/text_size_l"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvUserSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_coparent_lite"
                        android:textSize="@dimen/text_size_s"
                        android:textColor="@color/gray_500"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Coparental Card — show connected coparent -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CoParent.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_m"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_seu_coparental"
                    android:textSize="@dimen/text_size_xs"
                    android:textColor="@color/gray_500"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <LinearLayout
                    android:id="@+id/coparentConnectedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_size_ml"
                        android:layout_height="@dimen/avatar_size_ml"
                        android:background="@drawable/bg_avatar_coparent"
                        android:layout_marginEnd="@dimen/spacing_sm">

                        <TextView
                            android:id="@+id/tvCoparentAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="@dimen/text_size_l"
                            android:textStyle="bold"
                            android:textColor="@color/secondary_green"
                            android:text="@string/chat_avatar_fallback" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvCoparentName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_no_coparent"
                            android:textSize="@dimen/text_size_m"
                            android:textStyle="bold"
                            android:textColor="@color/gray_900"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="@dimen/spacing_xs">

                            <View
                                android:layout_width="@dimen/icon_dot_size_s"
                                android:layout_height="@dimen/icon_dot_size_s"
                                android:background="@drawable/bg_dot_green"
                                android:layout_marginEnd="@dimen/spacing_s"
                                android:elevation="0dp" />

                            <TextView
                                android:id="@+id/tvCoparentStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_conectado"
                                android:textSize="@dimen/text_size_s"
                                android:textColor="@color/gray_500" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInviteConnected"
                        style="@style/Widget.CoParent.Button.Outlined.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:text="@string/ui_convidar"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:minWidth="0dp"
                        android:visibility="gone"
                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/emptyStateCoparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="@dimen/spacing_s">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_no_coparent"
                        android:textSize="@dimen/text_size_m"
                        android:textStyle="bold"
                        android:textColor="@color/gray_700" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:gravity="center"
                        android:text="@string/profile_invite_coparent"
                        android:textSize="@dimen/text_size_s"
                        android:textColor="@color/gray_500" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInvite"
                        style="@style/Widget.CoParent.Button.Outlined.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:text="@string/ui_convidar"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:minWidth="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Children Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CoParent.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_m"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_seus_filhos"
                        android:textSize="@dimen/text_size_xs"
                        android:textColor="@color/gray_500"
                        android:letterSpacing="0.05"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddChild"
                        style="@style/Widget.CoParent.Button.Outlined.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:text="@string/ui_adicionar"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:minWidth="0dp"
                        />
                </LinearLayout>

                <!-- Children list container -->
                <LinearLayout
                    android:id="@+id/childrenContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <ProgressBar
                    android:id="@+id/progressLoadingChildren"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="@dimen/spacing_m"
                    android:visibility="gone"
                    android:accessibilityLiveRegion="polite"
                    android:contentDescription="@string/cd_loading_children" />

                <LinearLayout
                    android:id="@+id/errorStateChildren"
                    style="@style/Widget.CoParent.State.Container.Content"
                    android:paddingVertical="@dimen/spacing_m"
                    android:accessibilityLiveRegion="polite"
                    android:contentDescription="@string/cd_error_children">

                    <ImageView
                        style="@style/Widget.CoParent.State.Icon.Error.Compact"
                        android:src="@drawable/ic_error_circle"
                        app:tint="@color/error"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/TextAppearance.CoParent.State.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:gravity="center"
                        android:text="@string/children_error_message" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetryChildren"
                        style="@style/Widget.CoParent.Button.Outlined.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:text="@string/action_try_again" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CoParent.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_m"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/stroke_width_thin">

                <!-- Settings row: Notificações -->
                <LinearLayout
                    android:id="@+id/rowNotifications"
                    style="@style/Widget.CoParent.Settings.Row">

                    <FrameLayout
                        style="@style/Widget.CoParent.Settings.IconContainer.Primary">

                        <ImageView
                            style="@style/Widget.CoParent.Settings.Icon"
                            android:src="@drawable/ic_notification_bell"
                            app:tint="@color/primary_blue"
                            android:contentDescription="@string/ui_notificacoes" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.CoParent.SettingsItem"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_notificacoes" />

                    <ImageView
                        android:layout_width="@dimen/icon_badge_size"
                        android:layout_height="@dimen/icon_badge_size"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/gray_400"
                        android:contentDescription="@string/ui_ir_para" />
                </LinearLayout>

                <View style="@style/Widget.CoParent.Settings.Divider" />

                <!-- Settings row: Privacidade -->
                <LinearLayout
                    android:id="@+id/rowPrivacy"
                    style="@style/Widget.CoParent.Settings.Row">

                    <FrameLayout
                        style="@style/Widget.CoParent.Settings.IconContainer.Primary">

                        <ImageView
                            style="@style/Widget.CoParent.Settings.Icon"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/primary_blue"
                            android:contentDescription="@string/ui_privacidade" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.CoParent.SettingsItem"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_privacidade_e_seguranca" />

                    <ImageView
                        android:layout_width="@dimen/icon_badge_size"
                        android:layout_height="@dimen/icon_badge_size"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/gray_400"
                        android:contentDescription="@string/ui_ir_para" />
                </LinearLayout>

                <View style="@style/Widget.CoParent.Settings.Divider" />

                <!-- Settings row: Logout (destructive) -->
                <LinearLayout
                    android:id="@+id/rowLogout"
                    style="@style/Widget.CoParent.Settings.Row">

                    <FrameLayout
                        style="@style/Widget.CoParent.Settings.IconContainer.Danger">

                        <ImageView
                            style="@style/Widget.CoParent.Settings.Icon"
                            android:src="@drawable/ic_logout"
                            app:tint="@color/error"
                            android:contentDescription="@string/ui_sair" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.CoParent.SettingsItem.Danger"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_sair_da_conta" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- App Version Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_coparent_lite_v1_0"
            android:textSize="@dimen/text_size_xs"
            android:textColor="@color/gray_400"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_s" />
    </LinearLayout>
</ScrollView>
