<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            style="@style/Widget.CoParent.TopBar.Row.Surface">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/Widget.CoParent.TouchTarget.Icon"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/gray_900"
                android:contentDescription="@string/cd_back_button" />

            <TextView
                style="@style/TextAppearance.CoParent.TopBar.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_editar_dados"
                android:layout_marginStart="@dimen/spacing_sm" />
        </LinearLayout>

        <View style="@style/Widget.CoParent.Header.Divider" />

        <LinearLayout
            style="@style/Widget.CoParent.Form.Content">

            <!-- Avatar com opção de foto -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/spacing_l">

                <LinearLayout
                    android:id="@+id/btnChildPhoto"
                    android:layout_width="@dimen/avatar_size_xl_plus"
                    android:layout_height="@dimen/avatar_size_xl_plus"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_avatar_child"
                    android:clipToOutline="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_add_child_photo">

                    <ImageView
                        android:id="@+id/ivChildPhoto"
                        android:layout_width="@dimen/avatar_size_xl_plus"
                        android:layout_height="@dimen/avatar_size_xl_plus"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvChildInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="@dimen/text_size_xxxl"
                        android:textStyle="bold"
                        android:textColor="@color/warning" />
                </LinearLayout>

                <!-- Camera badge -->
                <FrameLayout
                    android:layout_width="@dimen/icon_container_size_xs"
                    android:layout_height="@dimen/icon_container_size_xs"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_badge_camera">

                    <ImageView
                        android:layout_width="@dimen/icon_size_xs"
                        android:layout_height="@dimen/icon_size_xs"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/on_primary"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </FrameLayout>

            <!-- Nome -->
            <TextView
                style="@style/TextAppearance.CoParent.Form.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_nome" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.CoParent.Form.TextInputLayout"
                app:hintEnabled="false"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etChildName"
                    style="@style/Widget.CoParent.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ui_nome_do_filho_a"
                    android:inputType="textPersonName|textCapWords|textAutoCorrect"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Data de nascimento -->
            <TextView
                style="@style/TextAppearance.CoParent.Form.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_data_de_nascimento" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.CoParent.Form.TextInputLayout"
                app:hintEnabled="false"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconTint="@color/gray_500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBirthDate"
                    style="@style/Widget.CoParent.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ui_dd_mm_aaaa"
                    android:inputType="none"
                    android:focusable="true"
                    android:clickable="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Guarda -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbHasCustody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:text="@string/ui_possuo_a_guarda_desta_crianca"
                android:textSize="@dimen/text_size_m"
                android:textColor="@color/gray_700"
                app:buttonTint="@color/primary_blue" />

            <!-- Botão Salvar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.CoParent.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_salvar_alteracoes"
                android:layout_marginBottom="@dimen/spacing_m" />

            <!-- Nota de segurança -->
            <TextView
                style="@style/TextAppearance.CoParent.Form.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_as_alteracoes_sao_registradas_no_historico_oficial"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
