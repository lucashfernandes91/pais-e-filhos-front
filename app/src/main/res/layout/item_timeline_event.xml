<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_xs">

    <!-- Timeline icon + line -->
    <LinearLayout
        style="@style/Widget.CoParent.Timeline.Gutter">

        <View
            android:layout_width="@dimen/stroke_width_thin"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/divider" />

        <ImageView
            android:id="@+id/timelineDotIcon"
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:src="@drawable/ic_other"
            app:tint="@color/primary_blue_light"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="@dimen/stroke_width_thin"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/divider" />
    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        style="@style/Widget.CoParent.Timeline.Content">

        <TextView
            style="@style/TextAppearance.CoParent.List.Meta.Muted"
            android:id="@+id/eventDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            style="@style/TextAppearance.CoParent.List.Title"
            android:id="@+id/eventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/TextAppearance.CoParent.List.Meta.Muted"
            android:id="@+id/eventNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/eventType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/eventCreator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
