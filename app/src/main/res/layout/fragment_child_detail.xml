<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Top Bar -->
    <LinearLayout
        style="@style/Widget.CoParent.TopBar.Row.Surface">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/gray_900"
            android:contentDescription="@string/cd_back_button" />

        <TextView
            style="@style/TextAppearance.CoParent.TopBar.Title"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_detalhes_do_filho"
            android:layout_marginStart="@dimen/spacing_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdit"
            style="@style/Widget.CoParent.Button.Text.Compact"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/ui_editar"
            android:textColor="@color/primary_blue"
            android:textAllCaps="false"
            app:icon="@drawable/ic_edit"
            app:iconTint="@color/primary_blue"
            app:iconGravity="textStart" />
    </LinearLayout>

    <View style="@style/Widget.CoParent.Header.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Header card: avatar + nome + idade -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CoParent.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_m"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="@dimen/spacing_l">

                    <FrameLayout
                        android:id="@+id/btnChildPhoto"
                        android:layout_width="@dimen/avatar_frame_size_xxl"
                        android:layout_height="@dimen/avatar_frame_size_xxl"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/cd_add_child_photo">

                        <FrameLayout
                            android:layout_width="@dimen/avatar_size_xxl"
                            android:layout_height="@dimen/avatar_size_xxl"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_avatar_child"
                            android:clipToOutline="true">

                            <ImageView
                                android:id="@+id/ivChildPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                android:contentDescription="@string/ui_foto_do_filho" />

                            <TextView
                                android:id="@+id/tvChildInitial"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/chat_avatar_fallback"
                                android:textSize="@dimen/text_size_display"
                                android:textStyle="bold"
                                android:textColor="@color/warning"
                                tools:text="L" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="@dimen/icon_container_size_xs"
                            android:layout_height="@dimen/icon_container_size_xs"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_badge_camera">

                            <ImageView
                                android:layout_width="@dimen/icon_size_xs"
                                android:layout_height="@dimen/icon_size_xs"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/on_primary"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvChildName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_l_plus"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        tools:text="Lara Silva" />

                    <TextView
                        android:id="@+id/tvChildAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textSize="@dimen/text_size_s"
                        android:textColor="@color/gray_500"
                        tools:text="8 anos" />

                    <!-- Badge "Sob sua guarda" -->
                    <LinearLayout
                        android:id="@+id/badgeCustody"
                        style="@style/Widget.CoParent.Badge.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="@drawable/bg_badge_active"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/secondary_green"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:contentDescription="@string/ui_guarda" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_sob_sua_guarda"
                            android:textSize="@dimen/text_size_xs"
                            android:textStyle="bold"
                            android:textColor="@color/secondary_green" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Informações pessoais -->
            <TextView
                style="@style/TextAppearance.CoParent.Detail.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_informacoes"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_s" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CoParent.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_m"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xs">

                    <!-- Data de nascimento -->
                    <LinearLayout
                        android:id="@+id/rowBirthDate"
                        style="@style/Widget.CoParent.Detail.Row">

                        <FrameLayout
                            style="@style/Widget.CoParent.Detail.IconFrame">

                            <ImageView
                                style="@style/Widget.CoParent.Settings.Icon"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/primary_blue"
                                android:contentDescription="@string/ui_data_de_nascimento" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.CoParent.List.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_data_de_nascimento" />

                            <TextView
                                android:id="@+id/tvBirthDate"
                                style="@style/TextAppearance.CoParent.Detail.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                tools:text="15/03/2017" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_width_thin"
                        android:layout_marginStart="@dimen/divider_inset_detail"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/rowCustody"
                        style="@style/Widget.CoParent.Detail.Row">

                        <FrameLayout
                            style="@style/Widget.CoParent.Detail.IconFrame">

                            <ImageView
                                style="@style/Widget.CoParent.Settings.Icon"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/primary_blue"
                                android:contentDescription="@string/ui_guarda" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.CoParent.List.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ui_guarda" />

                            <TextView
                                android:id="@+id/tvCustodyValue"
                                style="@style/TextAppearance.CoParent.Detail.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botão Remover -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveChild"
                style="@style/Widget.CoParent.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/ui_remover_filho"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/error"
                app:iconSize="@dimen/icon_size_sm"
                app:iconGravity="textStart" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
