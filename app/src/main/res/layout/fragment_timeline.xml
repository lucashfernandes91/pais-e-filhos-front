<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m"
        android:layout_marginBottom="@dimen/spacing_s">

        <TextView
            style="@style/TextStyle.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Linha do tempo" />

        <TextView
            style="@style/TextStyle.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tudo em ordem cronológica" />
    </LinearLayout>

    <!-- Info Banner -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:layout_marginBottom="@dimen/spacing_m"
        app:cardBackgroundColor="@color/secondary_green_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_m"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:src="@drawable/ic_info"
                app:tint="@color/secondary_green"
                android:contentDescription="Info" />

            <TextView
                style="@style/TextStyle.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Todas as mensagens e eventos têm registro oficial e podem ser exportados em PDF."
                android:layout_marginStart="@dimen/spacing_m"
                android:textColor="@color/secondary_green" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Timeline List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timelineRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingVertical="@dimen/spacing_s"
        android:clipToPadding="false" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyStateTimeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_schedule"
            app:tint="@color/gray_300"
            android:layout_marginBottom="16dp"
            android:contentDescription="Sem itens" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Linha do tempo vazia"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/gray_700"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensagens e eventos aparecer\u00e3o aqui em ordem cronol\u00f3gica."
            android:textSize="14sp"
            android:textColor="@color/gray_400"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</LinearLayout>
