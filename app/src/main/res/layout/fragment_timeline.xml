<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_m"
        android:layout_marginBottom="@dimen/spacing_s">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextStyle.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_linha_do_tempo" />

            <TextView
                style="@style/TextStyle.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_tudo_em_ordem_cronologica" />
        </LinearLayout>

        <!-- Export button -->
        <ImageButton
            android:id="@+id/btnExportTimeline"
            style="@style/Widget.CoParent.TouchTarget.Icon"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:src="@drawable/ic_export"
            app:tint="@color/icon_muted"
            android:contentDescription="@string/cd_export_timeline_button" />
    </LinearLayout>

    <View style="@style/Widget.CoParent.Header.Divider" />

    <!-- Info Banner -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.CoParent.Card.Info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:layout_marginBottom="@dimen/spacing_m"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_m"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:src="@drawable/ic_info"
                app:tint="@color/icon_info"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/TextStyle.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_todas_as_mensagens_e_eventos_tem_registro_oficial"
                android:layout_marginStart="@dimen/spacing_m"
                android:textColor="@color/info_banner_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progressLoadingTimeline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_l"
        android:accessibilityLiveRegion="polite"
        android:contentDescription="@string/cd_loading_timeline" />

    <!-- Timeline List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timelineRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingVertical="@dimen/spacing_s"
        android:clipToPadding="false" />

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/errorStateTimeline"
        style="@style/Widget.CoParent.State.Container.Fill"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:accessibilityLiveRegion="polite"
        android:contentDescription="@string/cd_error_timeline">

        <ImageView
            style="@style/Widget.CoParent.State.Icon.Error"
            android:src="@drawable/ic_error_circle"
            app:tint="@color/error"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/TextAppearance.CoParent.State.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/state_error_title" />

        <TextView
            style="@style/TextAppearance.CoParent.State.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:text="@string/timeline_error_message" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryTimeline"
            style="@style/Widget.CoParent.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/action_try_again" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyStateTimeline"
        style="@style/Widget.CoParent.State.Container.Fill"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:accessibilityLiveRegion="polite"
        android:contentDescription="@string/cd_empty_timeline">

        <ImageView
            style="@style/Widget.CoParent.State.Icon.Empty"
            android:src="@drawable/ic_schedule"
            app:tint="@color/gray_300"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            style="@style/TextAppearance.CoParent.State.EmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_linha_do_tempo_vazia"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            style="@style/TextAppearance.CoParent.State.EmptyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_mensagens_e_eventos_aparecerao_aqui_em_ordem_cronologica"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/spacing_xs" />
    </LinearLayout>
</LinearLayout>
